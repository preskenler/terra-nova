<% content_for :title, t("accounts.title") %>

<%= render Ui::BreadcrumbsComponent.new(items: [
      { label: t("nav.home"), path: root_path },
      { label: t("nav.my_space"), path: citizen_dashboard_path },
      { label: t("accounts.title") }
    ]) %>

<h1 class="mt-4 text-2xl font-bold"><%= t("accounts.title") %></h1>

<div class="mt-4 grid max-w-2xl gap-4">
  <%= render Ui::CardComponent.new(title: t("account.data.title")) do %>
    <p class="text-sm text-base-content/80"><%= t("account.data.short") %></p>
    <%= link_to t("account.data.view"), data_account_path, class: "btn btn-primary btn-sm mt-2" %>
  <% end %>

  <%= render Ui::CardComponent.new do %>
    <p><%= t("accounts.explanation") %></p>

    <%= form_with url: account_path, method: :delete, class: "mt-4 space-y-3" do %>
      <div>
        <label for="password" class="mb-1 block text-sm font-medium"><%= t("accounts.password_label") %></label>
        <%= password_field_tag :password, nil, id: "password",
              class: "input input-bordered w-full", autocomplete: "current-password", required: true %>
        <p class="mt-1 text-xs text-base-content/60"><%= t("accounts.password_hint") %></p>
      </div>

      <%= submit_tag t("accounts.delete"), class: "btn btn-error",
            data: { turbo_confirm: t("accounts.confirm") } %>
    <% end %>
  <% end %>
</div>
