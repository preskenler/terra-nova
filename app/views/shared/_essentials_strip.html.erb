<%# Compact strip pointing to the essential information that stays available during
    an incident (F93/F94). Lightweight and DB-independent enough to render anywhere. %>
<div role="status" class="alert alert-info">
  <div>
    <p class="font-semibold"><%= t("essentials.strip.title") %></p>
    <p class="text-sm"><%= t("essentials.strip.body") %></p>
    <% emergency_services = @information&.dig(:emergency_services) || EssentialInformation.call[:emergency_services] %>
    <p class="mt-1 text-sm">
      <% emergency_services.each_with_index do |item, index| %>
        <%= "· " if index.positive? %>
        <a class="link" href="tel:<%= item[:phone] %>"><%= item[:name] %> <%= item[:phone] %></a>
      <% end %>
    </p>
    <%= link_to t("essentials.title"), essentials_path, class: "btn btn-sm mt-2" %>
  </div>
</div>
