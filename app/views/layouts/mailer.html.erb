<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <style>
      body { margin: 0; padding: 0; background: #eef3ef; color: #22322a;
        font-family: Inter, Arial, Helvetica, sans-serif; }
      .email-wrapper { max-width: 600px; margin: 0 auto; padding: 24px; }
      .email-card { background: #ffffff; border: 1px solid #dbe4dd; border-radius: 12px;
        padding: 28px; }
      .email-card h1 { margin: 0 0 16px; color: #1f6b45; font-size: 20px; line-height: 1.2; }
      .email-card p { margin: 0 0 12px; font-size: 15px; line-height: 1.6; }
      .email-card a { color: #1f6b45; }
      .email-card ul { margin: 0 0 12px; padding-left: 20px; font-size: 15px; line-height: 1.6; }
      .email-footer { margin: 16px 0 0; text-align: center; font-size: 12px; color: #6b7a70; }
    </style>
  </head>

  <body>
    <div class="email-wrapper">
      <div class="email-card">
        <%= yield %>
      </div>
      <p class="email-footer"><%= t("app.name") %> — <%= t("app.footer_tagline") %></p>
    </div>
  </body>
</html>
