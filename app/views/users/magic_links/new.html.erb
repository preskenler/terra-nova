<% content_for :title, t("magic_links.title") %>

<%= render Ui::BreadcrumbsComponent.new(items: [
      { label: t("nav.home"), path: root_path },
      { label: t("magic_links.title") }
    ]) %>

<h1 class="mt-4 text-2xl font-bold"><%= t("magic_links.title") %></h1>
<p class="mt-1 max-w-2xl text-base-content/70"><%= t("magic_links.intro") %></p>

<%= form_with url: users_magic_link_path, method: :post, class: "mt-6 max-w-md space-y-4" do %>
  <div>
    <label for="magic_email" class="mb-1 block text-sm font-medium"><%= t("magic_links.email") %></label>
    <%= email_field_tag :email, nil, id: "magic_email", class: "input input-bordered w-full",
          autocomplete: "email", required: true %>
  </div>

  <%= submit_tag t("magic_links.submit"), class: "btn btn-primary" %>

  <p class="text-sm">
    <%= link_to t("nav.sign_in"), new_user_session_path, class: "link" %>
  </p>
<% end %>
