<% content_for :title, t("magic_links.title") %>

<%= render layout: "devise/shared/auth_shell", locals: {
      eyebrow: t("auth.citizen_space"),
      title: t("magic_links.title"),
      subtitle: t("magic_links.intro")
    } do %>
  <%= form_with url: users_magic_link_path, method: :post, class: "space-y-4" do %>
    <div class="grid gap-1.5">
      <label for="magic_email" class="text-sm font-semibold"><%= t("magic_links.email") %></label>
      <%= email_field_tag :email, nil, id: "magic_email", class: "input input-bordered w-full",
            autocomplete: "email", required: true %>
    </div>
    <%= submit_tag t("magic_links.submit"), class: "btn btn-primary w-full" %>
  <% end %>
  <nav class="mt-5 flex flex-wrap gap-x-4 gap-y-2 border-t border-base-300 pt-5 text-sm" aria-label="<%= t("auth.links.title") %>">
    <%= link_to t("nav.sign_in"), new_user_session_path %>
  </nav>
<% end %>
