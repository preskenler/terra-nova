<% content_for :title, @announcement.title %>

<%= render Ui::BreadcrumbsComponent.new(items: [
      { label: t("nav.home"), path: root_path },
      { label: t("announcements.title"), path: announcements_path },
      { label: @announcement.title }
    ]) %>

<article class="mt-4 max-w-3xl">
  <div class="flex flex-wrap items-center justify-between gap-2">
    <h1 class="text-2xl font-bold"><%= @announcement.title %></h1>
    <%= render Ui::BadgeComponent.new(
          label: t("severities.#{@announcement.severity}"),
          variant: severity_badge_variant(@announcement.severity)) %>
  </div>

  <% if @announcement.published_at.present? %>
    <time class="mt-1 block text-sm text-base-content/60" datetime="<%= @announcement.published_at.iso8601 %>">
      <%= l(@announcement.published_at, format: :long) %>
    </time>
  <% end %>

  <p class="mt-4 whitespace-pre-line text-base-content/90"><%= @announcement.body %></p>
</article>
