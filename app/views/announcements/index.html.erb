<% content_for :title, t("announcements.title") %>

<%= render Ui::BreadcrumbsComponent.new(items: [
      { label: t("nav.home"), path: root_path },
      { label: t("announcements.title") }
    ]) %>

<%= render Ui::PageHeaderComponent.new(title: t("announcements.title"), subtitle: t("announcements.subtitle")) %>

<% if @announcements.any? %>
  <ul class="mt-6 space-y-4">
    <% @announcements.each do |announcement| %>
      <li class="rounded-box border border-base-300 bg-base-100 p-4">
        <div class="flex flex-wrap items-center justify-between gap-2">
          <h2 class="text-lg font-semibold">
            <%= link_to announcement.title, announcement_path(announcement), class: "link link-hover" %>
          </h2>
          <%= render Ui::BadgeComponent.new(
                label: t("severities.#{announcement.severity}"),
                variant: severity_badge_variant(announcement.severity)) %>
        </div>
        <% if announcement.published_at.present? %>
          <time class="mt-1 block text-xs text-base-content/60" datetime="<%= announcement.published_at.iso8601 %>">
            <%= l(announcement.published_at, format: :long) %>
          </time>
        <% end %>
        <p class="mt-2 text-base-content/80"><%= truncate(announcement.body.to_s, length: 180) %></p>
      </li>
    <% end %>
  </ul>
<% else %>
  <div class="mt-6">
    <%= render Ui::EmptyStateComponent.new(title: t("announcements.empty")) %>
  </div>
<% end %>
