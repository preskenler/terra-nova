<% content_for :title, @service.name %>
<% if @service.location? && !reduced_data? %>
  <% content_for :head do %>
    <%= stylesheet_link_tag "leaflet", "data-turbo-track": "reload" %>
  <% end %>
<% end %>

<%= render Ui::BreadcrumbsComponent.new(items: [
      { label: t("nav.home"), path: root_path },
      { label: t("services.title"), path: services_path },
      { label: @service.name }
    ]) %>

<div class="mt-4 grid gap-6 lg:grid-cols-3">
  <div class="space-y-4 lg:col-span-2">
    <div class="flex flex-wrap items-center gap-2">
      <h1 class="text-2xl font-bold"><%= @service.name %></h1>
      <% if @service.priority? %>
        <%= render Ui::BadgeComponent.new(label: t("services.priority.badge"), variant: :primary) %>
      <% end %>
      <%= render Ui::BadgeComponent.new(
            label: t("services.status.#{@service.status}"),
            variant: service_status_variant(@service)) %>
    </div>

    <% if @service.maintenance? %>
      <div role="status" class="alert alert-warning">
        <div>
          <p class="font-semibold"><%= t("services.maintenance.title") %></p>
          <p><%= @service.maintenance_message.presence || t("services.maintenance.default_message") %></p>
          <% if @service.expected_return.present? %>
            <p class="text-sm"><%= t("services.maintenance.expected_return", time: @service.expected_return) %></p>
          <% end %>
        </div>
      </div>
    <% end %>

    <section class="prose max-w-none">
      <p class="whitespace-pre-line text-base-content/90"><%= @service.description %></p>
    </section>

    <% if @service.location? %>
      <section aria-labelledby="location-heading">
        <%= render Ui::SectionHeadingComponent.new(title: t("services.location.title"), id: "location-heading") %>
        <% unless reduced_data? %>
          <div class="mt-2"
               data-controller="map"
               data-map-lat-value="<%= @service.latitude %>"
               data-map-lng-value="<%= @service.longitude %>"
               data-map-label-value="<%= @service.name %>">
            <div data-map-target="container"
                 role="img"
                 aria-label="<%= t("services.map.label", name: @service.name) %>"
                 class="h-64 w-full overflow-hidden rounded-box border border-base-300"></div>
          </div>
        <% end %>
        <p class="mt-2 text-sm">
          <span class="font-medium"><%= @service.address %></span> —
          <%= link_to t("services.map.open"), "https://www.openstreetmap.org/?mlat=#{@service.latitude}&mlon=#{@service.longitude}#map=17/#{@service.latitude}/#{@service.longitude}",
                class: "link", target: "_blank", rel: "noopener" %>
          <% if reduced_data? %>
            <span class="text-base-content/60">(<%= t("a11y.reduced_data_note") %>)</span>
          <% end %>
        </p>
      </section>
    <% end %>
  </div>

  <aside class="space-y-4">
    <% if @service.contact_email.present? || @service.contact_phone.present? %>
      <section class="card border border-base-300 bg-base-100">
        <div class="card-body">
          <h2 class="card-title text-base"><%= t("services.contact.title") %></h2>
          <% if @service.contact_phone.present? %>
            <p>
              <a class="link font-mono" href="tel:<%= @service.contact_phone.gsub(/[^0-9+]/, "") %>">
                <%= @service.contact_phone %>
              </a>
            </p>
          <% end %>
          <% if @service.contact_email.present? %>
            <p><%= mail_to @service.contact_email, @service.contact_email, class: "link break-all" %></p>
          <% end %>
        </div>
      </section>
    <% end %>

    <% if @related_services.any? && !simple_mode? %>
      <section class="card border border-base-300 bg-base-100">
        <div class="card-body">
          <h2 class="card-title text-base"><%= t("services.related") %></h2>
          <ul class="space-y-2 text-sm">
            <% @related_services.each do |related| %>
              <li><%= link_to related.name, service_path(related), class: "link" %></li>
            <% end %>
          </ul>
        </div>
      </section>
    <% end %>
  </aside>
</div>

<section class="mt-10" aria-labelledby="reviews-heading">
  <%= render Ui::SectionHeadingComponent.new(title: t("service_reviews.title"), id: "reviews-heading") %>

  <% if @reviews.any? %>
    <ul class="mt-3 space-y-3">
      <% @reviews.each do |review| %>
        <li class="rounded-box border border-base-300 bg-base-100 p-4">
          <div class="flex flex-wrap items-center justify-between gap-2">
            <span class="font-medium"><%= review.user.display_name %></span>
            <span class="text-sm text-base-content/70">
              <% if review.rating.present? %>
                <span aria-label="<%= t("service_reviews.rating_aria", count: review.rating) %>"><%= review.rating %>/5</span>
              <% else %>
                <span><%= t("service_reviews.no_rating") %></span>
              <% end %>
            </span>
          </div>
          <p class="mt-1 whitespace-pre-line text-sm text-base-content/80"><%= review.comment %></p>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="mt-2 text-sm text-base-content/60"><%= t("service_reviews.empty") %></p>
  <% end %>

  <% if user_signed_in? %>
    <div class="mt-4 max-w-2xl rounded-box border border-base-300 bg-base-100 p-4">
      <p class="text-sm font-semibold"><%= t("service_reviews.leave") %></p>
      <%= form_with model: @review, url: service_review_path(@service), class: "mt-2 space-y-3" do |f| %>
        <div>
          <%= f.label :rating, t("service_reviews.rating"), class: "mb-1 block text-sm font-medium" %>
          <%= f.select :rating, (1..5).map { |n| [ t("service_reviews.stars", count: n), n ] },
                { include_blank: t("service_reviews.no_rating") }, class: "select select-bordered select-sm" %>
        </div>
        <div>
          <%= f.label :comment, t("service_reviews.comment"), class: "mb-1 block text-sm font-medium" %>
          <%= f.text_area :comment, rows: 3, class: "textarea textarea-bordered w-full" %>
        </div>
        <%= f.submit t("service_reviews.submit"), class: "btn btn-primary btn-sm" %>
      <% end %>
    </div>
  <% end %>
</section>
