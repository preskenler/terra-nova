<% content_for :title, t("profiles.title") %>

<%= render Ui::BreadcrumbsComponent.new(items: [
      { label: t("nav.home"), path: root_path },
      { label: t("nav.my_space"), path: citizen_dashboard_path },
      { label: t("profiles.title") }
    ]) %>

<h1 class="mt-4 text-2xl font-bold"><%= t("profiles.title") %></h1>

<div class="mt-4 max-w-2xl">
  <%= render Ui::CardComponent.new do %>
    <dl class="grid gap-3 sm:grid-cols-2">
      <div>
        <dt class="text-base-content/60"><%= t("profiles.fields.email") %></dt>
        <dd class="font-medium"><%= current_user.email %></dd>
      </div>
      <div>
        <dt class="text-base-content/60"><%= t("profiles.fields.locale") %></dt>
        <dd class="font-medium"><%= t("languages.#{current_user.locale}") %></dd>
      </div>
      <div>
        <dt class="text-base-content/60"><%= t("profiles.fields.address") %></dt>
        <dd class="font-medium"><%= @profile.address.presence || "—" %></dd>
      </div>
      <div>
        <dt class="text-base-content/60"><%= t("profiles.fields.phone") %></dt>
        <dd class="font-medium"><%= @profile.phone.presence || "—" %></dd>
      </div>
      <div>
        <dt class="text-base-content/60"><%= t("profiles.fields.postal_code") %></dt>
        <dd class="font-medium"><%= @profile.postal_code.presence || "—" %></dd>
      </div>
      <div>
        <dt class="text-base-content/60"><%= t("profiles.fields.city") %></dt>
        <dd class="font-medium"><%= @profile.city.presence || "—" %></dd>
      </div>
    </dl>

    <div class="mt-4 flex flex-wrap gap-2">
      <%= link_to t("profiles.edit"), edit_profile_path, class: "btn btn-primary btn-sm" %>
      <%= link_to t("accounts.title"), account_path, class: "btn btn-ghost btn-sm" %>
    </div>
  <% end %>
</div>
