<% content_for :title, t("profiles.edit") %>

<%= render Ui::BreadcrumbsComponent.new(items: [
      { label: t("nav.home"), path: root_path },
      { label: t("nav.my_space"), path: citizen_dashboard_path },
      { label: t("profiles.title"), path: profile_path },
      { label: t("profiles.edit") }
    ]) %>

<h1 class="mt-4 text-2xl font-bold"><%= t("profiles.edit") %></h1>

<%= form_with url: profile_path, method: :patch, class: "mt-4 max-w-2xl space-y-6" do %>
  <fieldset class="rounded-box border border-base-300 bg-base-100 p-4">
    <legend class="px-1 text-lg font-semibold"><%= t("profiles.personal_info") %></legend>
    <div class="grid gap-3 sm:grid-cols-2">
      <div>
        <label for="profile_address" class="mb-1 block text-sm font-medium"><%= t("profiles.fields.address") %></label>
        <%= text_field_tag "profile[address]", @profile.address, id: "profile_address",
              class: "input input-bordered w-full", autocomplete: "street-address" %>
      </div>
      <div>
        <label for="profile_phone" class="mb-1 block text-sm font-medium"><%= t("profiles.fields.phone") %></label>
        <%= telephone_field_tag "profile[phone]", @profile.phone, id: "profile_phone",
              class: "input input-bordered w-full", autocomplete: "tel" %>
      </div>
      <div>
        <label for="profile_postal_code" class="mb-1 block text-sm font-medium"><%= t("profiles.fields.postal_code") %></label>
        <%= text_field_tag "profile[postal_code]", @profile.postal_code, id: "profile_postal_code",
              class: "input input-bordered w-full", autocomplete: "postal-code" %>
      </div>
      <div>
        <label for="profile_city" class="mb-1 block text-sm font-medium"><%= t("profiles.fields.city") %></label>
        <%= text_field_tag "profile[city]", @profile.city, id: "profile_city",
              class: "input input-bordered w-full", autocomplete: "address-level2" %>
      </div>
    </div>
  </fieldset>

  <fieldset class="rounded-box border border-base-300 bg-base-100 p-4">
    <legend class="px-1 text-lg font-semibold"><%= t("profiles.preferences") %></legend>

    <label for="user_locale" class="mb-1 block text-sm font-medium"><%= t("a11y.choose_language") %></label>
    <%= select_tag "user[locale]",
          options_for_select(I18n.available_locales.map { |l| [ t("languages.#{l}"), l ] }, current_user.locale),
          id: "user_locale", class: "select select-bordered w-full sm:w-64" %>

    <div class="mt-3 space-y-2">
      <label class="flex cursor-pointer items-center gap-2">
        <%= check_box_tag "user[high_contrast]", "1", current_user.high_contrast?, class: "checkbox checkbox-sm" %>
        <span><%= t("a11y.high_contrast") %></span>
      </label>
      <label class="flex cursor-pointer items-center gap-2">
        <%= check_box_tag "user[large_text]", "1", current_user.large_text?, class: "checkbox checkbox-sm" %>
        <span><%= t("a11y.large_text") %></span>
      </label>
      <label class="flex cursor-pointer items-center gap-2">
        <%= check_box_tag "user[reduced_data]", "1", current_user.reduced_data?, class: "checkbox checkbox-sm" %>
        <span><%= t("a11y.reduced_data") %></span>
      </label>
      <label class="flex cursor-pointer items-center gap-2">
        <%= check_box_tag "user[simple_mode]", "1", current_user.simple_mode?, class: "checkbox checkbox-sm" %>
        <span><%= t("a11y.simple_mode") %></span>
      </label>
    </div>
  </fieldset>

  <div class="flex gap-2">
    <%= submit_tag t("actions.save"), class: "btn btn-primary" %>
    <%= link_to t("actions.back"), profile_path, class: "btn btn-ghost" %>
  </div>
<% end %>
