<% content_for :title, t("partners.title") %>

<%= render Ui::BreadcrumbsComponent.new(items: [
      { label: t("nav.home"), path: root_path },
      { label: t("partners.title") }
    ]) %>

<%= render Ui::PageHeaderComponent.new(title: t("partners.title"), subtitle: t("partners.subtitle")) %>

<% if @partners.any? %>
  <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
    <% @partners.each do |partner| %>
      <article class="card border border-base-300 bg-base-100">
        <div class="card-body gap-2">
          <h3 class="card-title text-base"><%= link_to partner.name, partner_path(partner), class: "link link-hover" %></h3>
          <% if partner.category.present? %>
            <%= render Ui::BadgeComponent.new(label: t("partners.categories.#{partner.category}"), variant: :neutral) %>
          <% end %>
          <p class="text-sm text-base-content/80"><%= truncate(partner.description.to_s, length: 130) %></p>
          <% if partner.address.present? %><p class="text-xs text-base-content/60"><%= partner.address %></p><% end %>
        </div>
      </article>
    <% end %>
  </div>
<% else %>
  <%= render Ui::EmptyStateComponent.new(title: t("partners.empty")) %>
<% end %>
