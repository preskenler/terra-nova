<% content_for :title, @partner.name %>
<% if @partner.location? && !reduced_data? %>
  <% content_for :head do %>
    <%= stylesheet_link_tag "leaflet", "data-turbo-track": "reload" %>
  <% end %>
<% end %>

<%= render Ui::BreadcrumbsComponent.new(items: [
      { label: t("nav.home"), path: root_path },
      { label: t("partners.title"), path: partners_path },
      { label: @partner.name }
    ]) %>

<div class="mt-4 grid gap-6 lg:grid-cols-3">
  <div class="space-y-4 lg:col-span-2">
    <div class="flex flex-wrap items-center gap-2">
      <h1 class="text-2xl font-bold tracking-tight"><%= @partner.name %></h1>
      <% if @partner.category.present? %>
        <%= render Ui::BadgeComponent.new(label: t("partners.categories.#{@partner.category}"), variant: :neutral) %>
      <% end %>
      <%# F99 : disponible / indisponible, jamais signalé par la couleur seule. %>
      <%= render Ui::BadgeComponent.new(
            label: @partner.available? ? t("partners.available") : t("partners.unavailable"),
            variant: @partner.available? ? :success : :neutral) %>
    </div>
    <p class="whitespace-pre-line text-base-content/90"><%= @partner.description %></p>

    <%# F99 : la prochaine action possible. %>
    <% if @partner.next_action.present? %>
      <div class="rounded-box border border-base-300 bg-base-100 p-4">
        <p class="text-sm font-semibold"><%= t("partners.next_action") %></p>
        <p class="mt-1 text-sm text-base-content/80"><%= @partner.next_action %></p>
      </div>
    <% end %>

    <% if @partner.location? %>
      <section aria-labelledby="partner-location-heading">
        <%= render Ui::SectionHeadingComponent.new(title: t("partners.location"), id: "partner-location-heading") %>
        <% unless reduced_data? %>
          <div data-controller="map"
               data-map-lat-value="<%= @partner.latitude %>"
               data-map-lng-value="<%= @partner.longitude %>"
               data-map-label-value="<%= @partner.name %>">
            <div data-map-target="container" role="img"
                 aria-label="<%= t("partners.map_label", name: @partner.name) %>"
                 class="h-56 w-full overflow-hidden rounded-box border border-base-300"></div>
          </div>
        <% end %>
        <p class="mt-2 text-sm">
          <span class="font-medium"><%= @partner.address %></span> —
          <%= link_to t("services.map.open"), "https://www.openstreetmap.org/?mlat=#{@partner.latitude}&mlon=#{@partner.longitude}#map=17/#{@partner.latitude}/#{@partner.longitude}",
                class: "link", target: "_blank", rel: "noopener" %>
        </p>
      </section>
    <% end %>
  </div>

  <aside class="space-y-4">
    <section class="card border border-base-300 bg-base-100">
      <div class="card-body">
        <%= render Ui::SectionHeadingComponent.new(title: t("partners.hours")) %>
        <dl class="space-y-1 text-sm">
          <% (0..6).each do |wday| %>
            <% hours = @partner.hours_for(wday) %>
            <div class="flex justify-between gap-2">
              <dt class="text-base-content/60"><%= t("transports.weekdays.#{wday}") %></dt>
              <dd class="font-medium"><%= hours ? hours.label : t("partners.closed") %></dd>
            </div>
          <% end %>
        </dl>
      </div>
    </section>

    <% if @partner.phone.present? || @partner.website.present? %>
      <section class="card border border-base-300 bg-base-100">
        <div class="card-body">
          <%= render Ui::SectionHeadingComponent.new(title: t("services.contact.title")) %>
          <% if @partner.phone.present? %>
            <p><a class="link font-mono" href="tel:<%= @partner.phone.gsub(/[^0-9+]/, "") %>"><%= @partner.phone %></a></p>
          <% end %>
          <% if @partner.website.present? %>
            <p><%= link_to @partner.website, @partner.website, class: "link break-all", target: "_blank", rel: "noopener" %></p>
          <% end %>
        </div>
      </section>
    <% end %>
  </aside>
</div>
