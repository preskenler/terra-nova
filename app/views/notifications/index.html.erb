<% content_for :title, t("notifications.title") %>

<%= render Ui::BreadcrumbsComponent.new(items: [
      { label: t("nav.home"), path: root_path },
      { label: t("nav.my_space"), path: citizen_dashboard_path },
      { label: t("notifications.title") }
    ]) %>

<div class="mt-4">
  <h1 class="text-2xl font-bold"><%= t("notifications.title") %></h1>
  <p class="mt-1 text-base-content/70"><%= t("notifications.subtitle") %></p>
</div>

<% if @notifications.any? %>
  <ul class="mt-6 space-y-3">
    <% @notifications.each do |notification| %>
      <li><%= render "notifications/notification", notification: notification %></li>
    <% end %>
  </ul>
<% else %>
  <div class="mt-6">
    <%= render Ui::EmptyStateComponent.new(title: t("notifications.empty")) %>
  </div>
<% end %>
