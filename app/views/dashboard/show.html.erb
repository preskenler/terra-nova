<% content_for :title, t("dashboard.title") %>

<%= render Ui::PageHeaderComponent.new(title: t("dashboard.welcome", name: current_user.display_name), subtitle: t("dashboard.subtitle")) %>

<div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
  <%= render Ui::StatComponent.new(label: t("dashboard.requests"), value: @request_count) %>
  <%= render Ui::StatComponent.new(label: t("dashboard.open_requests"), value: @open_request_count) %>
  <%= render Ui::StatComponent.new(label: t("dashboard.appointments"), value: @appointment_count) %>
  <%= render Ui::StatComponent.new(label: t("dashboard.notifications"), value: @unread_notification_count) %>
</div>

<div class="mt-6 flex flex-wrap gap-2">
  <%= link_to t("requests.new"), new_request_path, class: "btn btn-primary btn-sm" %>
  <%= link_to t("requests.title"), requests_path, class: "btn btn-ghost btn-sm" %>
  <%= link_to t("notifications.title"), notifications_path, class: "btn btn-ghost btn-sm" %>
</div>

<div class="mt-6 grid gap-4 md:grid-cols-2">
  <%= render Ui::CardComponent.new(title: t("dashboard.recent_requests")) do %>
    <% if @recent_requests.any? %>
      <ul class="divide-y divide-base-200">
        <% @recent_requests.each do |request| %>
          <li class="flex items-center justify-between gap-2 py-2">
            <div class="min-w-0">
              <p class="truncate font-medium"><%= link_to request.subject, request_path(request), class: "link" %></p>
              <p class="font-mono text-xs text-base-content/60"><%= request.reference %></p>
            </div>
            <%= render Ui::BadgeComponent.new(
                  label: t("requests.status.#{request.status}"),
                  variant: request_badge_variant(request.status)) %>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="text-sm text-base-content/60"><%= t("dashboard.no_requests") %></p>
    <% end %>
  <% end %>

  <%= render Ui::CardComponent.new(title: t("dashboard.my_profile")) do %>
    <dl class="space-y-1 text-sm">
      <div class="flex gap-2">
        <dt class="text-base-content/60"><%= t("profiles.fields.email") %>:</dt>
        <dd><%= current_user.email %></dd>
      </div>
      <div class="flex gap-2">
        <dt class="text-base-content/60"><%= t("profiles.fields.address") %>:</dt>
        <dd><%= @profile.address.presence || "—" %></dd>
      </div>
    </dl>
    <div class="mt-4 flex gap-2">
      <%= link_to t("profiles.edit"), edit_profile_path, class: "btn btn-sm" %>
      <%= link_to t("accounts.title"), account_path, class: "btn btn-ghost btn-sm" %>
    </div>
  <% end %>
</div>
