<% content_for :title, @partner.name %>

<%= render Ui::BreadcrumbsComponent.new(items: [
      { label: t("agents.nav.dashboard"), path: agents_root_path },
      { label: t("agents.partners.title"), path: agents_partners_path },
      { label: @partner.name }
    ]) %>

<%= render Ui::PageHeaderComponent.new(title: @partner.name, subtitle: @partner.address) %>

<div class="grid gap-6 lg:grid-cols-3">
  <div class="space-y-4 lg:col-span-2">
    <p class="whitespace-pre-line text-base-content/90"><%= @partner.description %></p>

    <section class="rounded-box border border-base-300 bg-base-100 p-4" aria-labelledby="hours-heading">
      <%= render Ui::SectionHeadingComponent.new(title: t("partners.hours"), id: "hours-heading") %>
      <%= form_with url: hours_agents_partner_path(@partner), method: :patch, class: "space-y-2" do %>
        <% (0..6).each do |wday| %>
          <% record = @hours[wday] %>
          <div class="grid grid-cols-2 items-center gap-2 sm:grid-cols-[8rem_1fr_1fr_auto]">
            <span class="text-sm font-medium"><%= t("transports.weekdays.#{wday}") %></span>
            <%= text_field_tag "opening_hours[#{wday}][opens_at]", record&.opens_at,
                  class: "input input-bordered input-sm", placeholder: "09:00" %>
            <%= text_field_tag "opening_hours[#{wday}][closes_at]", record&.closes_at,
                  class: "input input-bordered input-sm", placeholder: "18:00" %>
            <label class="flex items-center gap-1 text-sm">
              <%= check_box_tag "opening_hours[#{wday}][closed]", "1", record&.closed?, class: "checkbox checkbox-sm" %>
              <%= t("partners.closed") %>
            </label>
          </div>
        <% end %>
        <%= submit_tag t("actions.save"), class: "btn btn-primary btn-sm" %>
      <% end %>
    </section>
  </div>

  <aside class="card border border-base-300 bg-base-100">
    <div class="card-body gap-3">
      <h2 class="card-title text-base"><%= t("agents.partners.actions_title") %></h2>
      <%= link_to t("actions.edit"), edit_agents_partner_path(@partner), class: "btn btn-primary btn-sm" %>
      <%= link_to t("actions.view"), partner_path(@partner), class: "btn btn-ghost btn-sm" %>
      <%= button_to t("actions.delete"), agents_partner_path(@partner), method: :delete,
            class: "btn btn-error btn-sm", data: { turbo_confirm: t("agents.partners.confirm_destroy") } %>
    </div>
  </aside>
</div>
