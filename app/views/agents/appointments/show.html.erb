<% content_for :title, t("agents.appointments.detail_title") %>

<%= render Ui::BreadcrumbsComponent.new(items: [
      { label: t("agents.nav.dashboard"), path: agents_root_path },
      { label: t("agents.appointments.title"), path: agents_appointments_path },
      { label: l(@appointment.starts_at, format: :short) }
    ]) %>

<div class="mt-4 max-w-2xl">
  <div class="flex flex-wrap items-center justify-between gap-2">
    <h1 class="text-2xl font-bold"><%= l(@appointment.starts_at, format: :long) %></h1>
    <%= render Ui::BadgeComponent.new(
          label: t("appointments.status.#{@appointment.status}"),
          variant: appointment_badge_variant(@appointment.status)) %>
  </div>

  <dl class="mt-4 grid grid-cols-2 gap-3 text-sm">
    <div>
      <dt class="text-base-content/60"><%= t("agents.appointments.columns.citizen") %></dt>
      <dd class="font-medium"><%= request_user_link(@appointment.user) %></dd>
    </div>
    <div>
      <dt class="text-base-content/60"><%= t("agents.appointments.columns.service") %></dt>
      <dd class="font-medium"><%= @appointment.service&.name || "—" %></dd>
    </div>
    <% if @appointment.notes.present? %>
      <div class="col-span-2">
        <dt class="text-base-content/60"><%= t("appointments.form.notes") %></dt>
        <dd class="font-medium"><%= @appointment.notes %></dd>
      </div>
    <% end %>
  </dl>

  <div class="mt-6 flex flex-wrap gap-2">
    <%= link_to t("agents.appointments.reschedule"), edit_agents_appointment_path(@appointment), class: "btn btn-primary btn-sm" %>
    <% if %w[requested confirmed].include?(@appointment.status) %>
      <%= button_to t("agents.appointments.cancel"), cancel_agents_appointment_path(@appointment), method: :patch,
            class: "btn btn-error btn-sm",
            data: { turbo_confirm: t("agents.appointments.confirm_cancel") } %>
    <% end %>
  </div>
</div>
