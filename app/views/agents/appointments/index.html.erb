<% content_for :title, t("agents.appointments.title") %>

<%= render Ui::BreadcrumbsComponent.new(items: [
      { label: t("agents.nav.dashboard"), path: agents_root_path },
      { label: t("agents.appointments.title") }
    ]) %>


<%= render Ui::PageHeaderComponent.new(title: t("agents.appointments.title"), subtitle: t("agents.appointments.subtitle")) do %>
    <%= link_to t("agents.availabilities.title"), agents_availabilities_path, class: "btn btn-ghost btn-sm" %>
<% end %>

<div class="mt-4 grid gap-4 sm:grid-cols-3">
  <%= render Ui::StatComponent.new(label: t("agents.appointments.upcoming"), value: @upcoming.size, emphasis: @upcoming.any?) %>
  <%= render Ui::StatComponent.new(label: t("agents.appointments.total"), value: @appointments.size) %>
</div>

<section class="mt-6" aria-labelledby="upcoming-heading">
  <%= render Ui::SectionHeadingComponent.new(title: t("agents.appointments.upcoming"), id: "upcoming-heading") %>
  <% if @upcoming.any? %>
    <div class="mt-2 overflow-x-auto rounded-box border border-base-300 bg-base-100">
      <table class="table table-zebra">
        <caption class="sr-only"><%= t("agents.appointments.upcoming_caption") %></caption>
        <thead>
          <tr>
            <th scope="col"><%= t("agents.appointments.columns.date") %></th>
            <th scope="col"><%= t("agents.appointments.columns.citizen") %></th>
            <th scope="col"><%= t("agents.appointments.columns.service") %></th>
            <th scope="col"><%= t("agents.appointments.columns.status") %></th>
            <th scope="col"><span class="sr-only"><%= t("actions.view") %></span></th>
          </tr>
        </thead>
        <tbody>
          <% @upcoming.each do |appointment| %>
            <tr>
              <th scope="row"><%= l(appointment.starts_at, format: :short) %></th>
              <td><%= appointment.user.email %></td>
              <td><%= appointment.service&.name || "—" %></td>
              <td><%= render Ui::BadgeComponent.new(label: t("appointments.status.#{appointment.status}"), variant: appointment_badge_variant(appointment.status)) %></td>
              <td class="text-right"><%= link_to t("actions.view"), agents_appointment_path(appointment), class: "btn btn-ghost btn-xs" %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <p class="mt-2 text-sm text-base-content/60"><%= t("agents.appointments.none_upcoming") %></p>
  <% end %>
</section>

<section class="mt-6" aria-labelledby="past-heading">
  <%= render Ui::SectionHeadingComponent.new(title: t("agents.appointments.past"), id: "past-heading") %>
  <% if (@appointments - @upcoming).any? %>
    <ul class="mt-2 divide-y divide-base-200 rounded-box border border-base-300 bg-base-100">
      <% (@appointments - @upcoming).each do |appointment| %>
        <li class="flex items-center justify-between gap-2 p-3">
          <div>
            <p class="font-medium"><%= l(appointment.starts_at, format: :short) %></p>
            <p class="text-sm text-base-content/60"><%= appointment.user.email %></p>
          </div>
          <div class="flex items-center gap-2">
            <%= render Ui::BadgeComponent.new(label: t("appointments.status.#{appointment.status}"), variant: appointment_badge_variant(appointment.status)) %>
            <%= link_to t("actions.view"), agents_appointment_path(appointment), class: "btn btn-ghost btn-xs" %>
          </div>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="mt-2 text-sm text-base-content/60"><%= t("agents.appointments.none_past") %></p>
  <% end %>
</section>
