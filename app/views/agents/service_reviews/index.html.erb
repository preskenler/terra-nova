<% content_for :title, t("agents.service_reviews.title") %>

<%= render Ui::BreadcrumbsComponent.new(items: [
      { label: t("agents.nav.dashboard"), path: agents_root_path },
      { label: t("agents.service_reviews.title") }
    ]) %>

<%= render Ui::PageHeaderComponent.new(title: t("agents.service_reviews.title"), subtitle: t("agents.service_reviews.subtitle")) %>

<div class="overflow-x-auto rounded-box border border-base-300 bg-base-100">
  <table class="table table-zebra">
    <caption class="sr-only"><%= t("agents.service_reviews.table_caption") %></caption>
    <thead>
      <tr>
        <th scope="col"><%= t("agents.service_reviews.columns.reference") %></th>
        <th scope="col"><%= t("agents.service_reviews.columns.service") %></th>
        <th scope="col"><%= t("agents.service_reviews.columns.user") %></th>
        <th scope="col"><%= t("agents.service_reviews.columns.comment") %></th>
        <th scope="col"><%= t("agents.service_reviews.columns.status") %></th>
        <th scope="col"><span class="sr-only"><%= t("agents.service_reviews.columns.actions") %></span></th>
      </tr>
    </thead>
    <tbody>
      <% @reviews.each do |review| %>
        <tr>
          <th scope="row" class="font-mono text-xs"><%= review.reference %></th>
          <td><%= review.service.name %></td>
          <td><%= review.user.email %></td>
          <td class="max-w-xs"><%= truncate(review.comment, length: 70) %><% if review.rating %> <span class="text-base-content/60">(<%= review.rating %>/5)</span><% end %></td>
          <td><%= render Ui::BadgeComponent.new(label: t("service_reviews.status.#{review.status}"), variant: review.published? ? :success : :neutral) %></td>
          <td class="text-right">
            <% if review.published? %>
              <%= button_to t("agents.service_reviews.hide"), agents_service_review_path(review), method: :patch,
                    params: { service_review: { status: "hidden" } }, class: "btn btn-ghost btn-xs" %>
            <% else %>
              <%= button_to t("agents.service_reviews.publish"), agents_service_review_path(review), method: :patch,
                    params: { service_review: { status: "published" } }, class: "btn btn-ghost btn-xs" %>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
