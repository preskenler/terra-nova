<% content_for :title, "#{@request.reference} — #{@request.subject}" %>
<% if @request.latitude.present? && @request.longitude.present? && !reduced_data? %>
  <% content_for :head do %>
    <%= stylesheet_link_tag "leaflet", "data-turbo-track": "reload" %>
  <% end %>
<% end %>

<%= render Ui::BreadcrumbsComponent.new(items: [
      { label: t("agents.nav.dashboard"), path: agents_root_path },
      { label: t("agents.requests.title"), path: agents_requests_path },
      { label: @request.reference }
    ]) %>

<div class="mt-4 grid gap-6 lg:grid-cols-3">
  <div class="space-y-4 lg:col-span-2">
    <div class="flex flex-wrap items-center justify-between gap-2">
      <div>
        <p class="font-mono text-sm text-base-content/60"><%= @request.reference %></p>
        <h1 class="text-2xl font-bold"><%= @request.subject %></h1>
      </div>
      <div class="flex flex-wrap gap-2">
        <%= render Ui::BadgeComponent.new(
              label: t("requests.status.#{@request.status}"),
              variant: request_badge_variant(@request.status)) %>
        <%= render Ui::BadgeComponent.new(
              label: t("requests.priority.#{@request.priority}"),
              variant: request_priority_variant(@request.priority)) %>
      </div>
    </div>

    <dl class="grid grid-cols-2 gap-3 text-sm sm:grid-cols-3">
      <div>
        <dt class="text-base-content/60"><%= t("agents.requests.fields.citizen") %></dt>
        <dd class="font-medium"><%= request_user_link(@request.user) %></dd>
      </div>
      <div>
        <dt class="text-base-content/60"><%= t("agents.requests.fields.service") %></dt>
        <dd class="font-medium"><%= @request.service&.name || "—" %></dd>
      </div>
      <div>
        <dt class="text-base-content/60"><%= t("requests.fields.submitted_at") %></dt>
        <dd class="font-medium"><%= l(@request.created_at, format: :short) %></dd>
      </div>
      <div>
        <dt class="text-base-content/60"><%= t("requests.fields.location") %></dt>
        <dd class="font-medium"><%= @request.location_text.presence || "—" %></dd>
      </div>
      <div>
        <dt class="text-base-content/60"><%= t("agents.requests.fields.supporters") %></dt>
        <dd class="font-medium"><%= @request.support_count %></dd>
      </div>
    </dl>

    <section>
      <%= render Ui::SectionHeadingComponent.new(title: t("requests.fields.description")) %>
      <p class="mt-1 whitespace-pre-line text-base-content/90"><%= @request.description %></p>
    </section>

    <% if @request.latitude.present? && @request.longitude.present? %>
      <section aria-labelledby="agent-request-location-heading">
        <%= render Ui::SectionHeadingComponent.new(title: t("services.location.title"), id: "agent-request-location-heading") %>
        <% unless reduced_data? %>
          <div class="mt-2"
               data-controller="map"
               data-map-lat-value="<%= @request.latitude %>"
               data-map-lng-value="<%= @request.longitude %>"
               data-map-label-value="<%= @request.location_text.presence || @request.subject %>">
            <div data-map-target="container"
                 role="img"
                 aria-label="<%= t("requests.map_label", reference: @request.reference) %>"
                 class="h-56 w-full overflow-hidden rounded-box border border-base-300"></div>
          </div>
        <% else %>
          <p class="mt-2 text-sm text-base-content/60"><%= t("a11y.reduced_data_note") %></p>
        <% end %>
      </section>
    <% end %>

    <section aria-labelledby="agent-timeline-heading">
      <%= render Ui::SectionHeadingComponent.new(title: t("requests.timeline.title"), id: "agent-timeline-heading") %>
      <div class="mt-2">
        <%= render "requests/timeline", events: @events %>
      </div>
    </section>
  </div>

  <aside class="space-y-4">
    <section class="card border border-base-300 bg-base-100">
      <div class="card-body">
        <h2 class="card-title text-base"><%= t("agents.requests.update_status") %></h2>

        <%= form_with model: @event, url: agents_request_path(@request), method: :patch, class: "space-y-3" do |f| %>
          <div>
            <%= f.label :to_status, t("agents.requests.fields.status"),
                  class: "mb-1 block text-sm font-medium" %>
            <%= f.select :to_status,
                  Request::STATUSES.keys.map { |s| [ t("requests.status.#{s}"), s ] },
                  {}, class: "select select-bordered select-sm w-full" %>
          </div>

          <div>
            <%= f.label :comment, t("agents.requests.fields.comment"),
                  class: "mb-1 block text-sm font-medium" %>
            <%= f.text_area :comment, rows: 4, class: "textarea textarea-bordered w-full" %>
          </div>

          <label class="flex cursor-pointer items-center gap-2">
            <%= f.check_box :visible_to_citizen, class: "checkbox checkbox-sm" %>
            <span class="text-sm"><%= t("agents.requests.fields.visible_to_citizen") %></span>
          </label>

          <%= f.submit t("actions.save"), class: "btn btn-primary btn-sm w-full" %>
        <% end %>
      </div>
    </section>

    <% if @request.request_supports.any? %>
      <section class="card border border-base-300 bg-base-100">
        <div class="card-body">
          <h2 class="card-title text-base"><%= t("requests.supports.title") %></h2>
          <ul class="space-y-1 text-sm">
            <% @request.request_supports.includes(:user).each do |support| %>
              <li><%= support.user.email %></li>
            <% end %>
          </ul>
        </div>
      </section>
    <% end %>

    <section class="card border border-base-300 bg-base-100">
      <div class="card-body">
        <%= render Ui::SectionHeadingComponent.new(title: t("agents.requests.priority")) %>
        <%= form_with url: prioritize_agents_request_path(@request), method: :patch, class: "flex flex-wrap items-end gap-2" do %>
          <div>
            <label for="request_priority" class="mb-1 block text-sm font-medium"><%= t("agents.requests.fields.priority") %></label>
            <%= select_tag "request[priority]",
                  options_for_select(Request.priorities.keys.map { |p| [ t("requests.priority.#{p}"), p ] }, @request.priority),
                  id: "request_priority", class: "select select-bordered select-sm" %>
          </div>
          <%= submit_tag t("agents.requests.save_priority"), class: "btn btn-primary btn-sm" %>
        <% end %>
      </div>
    </section>
  </aside>
</div>

<% if @similar_requests.any? %>
  <section class="mt-8" aria-labelledby="similar-heading">
    <%= render Ui::SectionHeadingComponent.new(title: t("agents.requests.similar"), id: "similar-heading") %>
    <p class="text-sm text-base-content/70"><%= t("agents.requests.similar_hint") %></p>
    <ul class="mt-3 space-y-2">
      <% @similar_requests.each do |similar| %>
        <li class="flex flex-wrap items-center justify-between gap-2 rounded-box border border-base-300 bg-base-100 p-3 text-sm">
          <div class="min-w-0">
            <p class="font-mono text-xs text-base-content/60"><%= similar.reference %></p>
            <p class="truncate"><%= link_to similar.subject, agents_request_path(similar), class: "link" %></p>
          </div>
          <%= button_to t("agents.requests.link_duplicate"),
                link_duplicate_agents_request_path(@request, duplicate_reference: similar.reference),
                method: :patch, class: "btn btn-ghost btn-xs" %>
        </li>
      <% end %>
    </ul>
  </section>
<% end %>
