<% content_for :title, @announcement.title %>

<%= render Ui::BreadcrumbsComponent.new(items: [
      { label: t("agents.nav.dashboard"), path: agents_root_path },
      { label: t("agents.announcements.title"), path: agents_announcements_path },
      { label: @announcement.title }
    ]) %>

<div class="mt-4 max-w-3xl">
  <div class="flex flex-wrap items-center justify-between gap-2">
    <h1 class="text-2xl font-bold"><%= @announcement.title %></h1>
    <%= render Ui::BadgeComponent.new(label: t("severities.#{@announcement.severity}"), variant: severity_badge_variant(@announcement.severity)) %>
  </div>
  <p class="mt-2 whitespace-pre-line text-base-content/90"><%= @announcement.body %></p>

  <div class="mt-6 flex flex-wrap gap-2">
    <%= link_to t("actions.edit"), edit_agents_announcement_path(@announcement), class: "btn btn-primary btn-sm" %>
    <%= button_to t("actions.delete"), agents_announcement_path(@announcement), method: :delete,
          class: "btn btn-error btn-sm", data: { turbo_confirm: t("agents.announcements.confirm_destroy") } %>
  </div>
</div>
