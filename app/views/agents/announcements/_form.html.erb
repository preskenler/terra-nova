<%= form_with model: announcement,
      url: announcement.persisted? ? agents_announcement_path(announcement) : agents_announcements_path,
      class: "space-y-4" do |f| %>
  <% if announcement.errors.any? %>
    <div role="alert" class="alert alert-error">
      <ul class="list-disc pl-5">
        <% announcement.errors.full_messages.each do |message| %><li><%= message %></li><% end %>
      </ul>
    </div>
  <% end %>

  <div class="grid gap-3 sm:grid-cols-2">
    <div>
      <%= f.label :title_fr, t("agents.announcements.fields.title_fr"), class: "mb-1 block text-sm font-medium" %>
      <%= f.text_field :title_fr, class: "input input-bordered w-full" %>
    </div>
    <div>
      <%= f.label :title_en, t("agents.announcements.fields.title_en"), class: "mb-1 block text-sm font-medium" %>
      <%= f.text_field :title_en, class: "input input-bordered w-full" %>
    </div>
    <div>
      <%= f.label :body_fr, t("agents.announcements.fields.body_fr"), class: "mb-1 block text-sm font-medium" %>
      <%= f.text_area :body_fr, rows: 4, class: "textarea textarea-bordered w-full" %>
    </div>
    <div>
      <%= f.label :body_en, t("agents.announcements.fields.body_en"), class: "mb-1 block text-sm font-medium" %>
      <%= f.text_area :body_en, rows: 4, class: "textarea textarea-bordered w-full" %>
    </div>
  </div>

  <div class="grid gap-3 sm:grid-cols-3">
    <div>
      <%= f.label :severity, t("agents.announcements.fields.severity"), class: "mb-1 block text-sm font-medium" %>
      <%= f.select :severity, Announcement::SEVERITIES.keys.map { |s| [ t("severities.#{s}"), s ] }, {}, class: "select select-bordered w-full" %>
    </div>
    <div>
      <%= f.label :target_audience, t("agents.announcements.fields.audience"), class: "mb-1 block text-sm font-medium" %>
      <%= f.select :target_audience, Announcement::AUDIENCES.keys.map { |a| [ t("audiences.#{a}"), a ] }, {}, class: "select select-bordered w-full" %>
    </div>
    <div>
      <%= f.label :published_at, t("agents.announcements.fields.published_at"), class: "mb-1 block text-sm font-medium" %>
      <%= f.datetime_local_field :published_at, class: "input input-bordered w-full" %>
    </div>
    <div>
      <%= f.label :starts_at, t("agents.announcements.fields.starts_at"), class: "mb-1 block text-sm font-medium" %>
      <%= f.datetime_local_field :starts_at, class: "input input-bordered w-full" %>
    </div>
    <div>
      <%= f.label :ends_at, t("agents.announcements.fields.ends_at"), class: "mb-1 block text-sm font-medium" %>
      <%= f.datetime_local_field :ends_at, class: "input input-bordered w-full" %>
    </div>
    <label class="flex cursor-pointer items-center gap-2 pt-6">
      <%= f.check_box :active, class: "checkbox checkbox-sm" %>
      <span class="text-sm"><%= t("agents.announcements.fields.active") %></span>
    </label>
    <label class="flex cursor-pointer items-center gap-2 pt-6">
      <%= f.check_box :pinned, class: "checkbox checkbox-sm" %>
      <span class="text-sm"><%= t("agents.announcements.fields.pinned") %></span>
    </label>
  </div>

  <div class="flex gap-2">
    <%= f.submit t("actions.save"), class: "btn btn-primary" %>
    <%= link_to t("actions.back"), agents_announcements_path, class: "btn btn-ghost" %>
  </div>
<% end %>
