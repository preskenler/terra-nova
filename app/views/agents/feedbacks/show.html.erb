<% content_for :title, "#{@feedback.reference} — #{@feedback.subject}" %>

<%= render Ui::BreadcrumbsComponent.new(items: [
      { label: t("agents.nav.dashboard"), path: agents_root_path },
      { label: t("agents.feedbacks.title"), path: agents_feedbacks_path },
      { label: @feedback.reference }
    ]) %>

<div class="mt-4 grid gap-6 lg:grid-cols-3">
  <section class="card border border-base-300 bg-base-100 lg:col-span-2">
    <div class="card-body">
      <p class="font-mono text-sm text-base-content/60"><%= @feedback.reference %></p>
      <h1 class="text-2xl font-bold"><%= @feedback.subject %></h1>

      <dl class="mt-3 grid grid-cols-2 gap-3 text-sm sm:grid-cols-3">
        <div>
          <dt class="text-base-content/60"><%= t("agents.feedbacks.columns.kind") %></dt>
          <dd class="font-medium"><%= t("feedbacks.kinds.#{@feedback.kind}") %></dd>
        </div>
        <div>
          <dt class="text-base-content/60"><%= t("feedbacks.fields.email") %></dt>
          <dd class="font-medium"><%= @feedback.user&.email || @feedback.email || "—" %></dd>
        </div>
        <div>
          <dt class="text-base-content/60"><%= t("agents.feedbacks.columns.date") %></dt>
          <dd class="font-medium"><%= l(@feedback.created_at, format: :short) %></dd>
        </div>
      </dl>

      <p class="mt-4 whitespace-pre-line text-base-content/90"><%= @feedback.message %></p>
    </div>
  </section>

  <aside class="card border border-base-300 bg-base-100">
    <div class="card-body">
      <h2 class="card-title text-base"><%= t("agents.feedbacks.handle") %></h2>

      <%= form_with model: @feedback, url: agents_feedback_path(@feedback), method: :patch, class: "space-y-3" do |f| %>
        <div>
          <%= f.label :status, t("agents.feedbacks.columns.status"), class: "mb-1 block text-sm font-medium" %>
          <%= f.select :status, Feedback::STATUSES.keys.map { |s| [ t("feedbacks.status.#{s}"), s ] }, {},
                class: "select select-bordered select-sm w-full" %>
        </div>
        <div>
          <%= f.label :agent_notes, t("agents.feedbacks.fields.notes"), class: "mb-1 block text-sm font-medium" %>
          <%= f.text_area :agent_notes, rows: 4, class: "textarea textarea-bordered w-full" %>
        </div>
        <%= f.submit t("actions.save"), class: "btn btn-primary btn-sm w-full" %>
      <% end %>
    </div>
  </aside>
</div>
