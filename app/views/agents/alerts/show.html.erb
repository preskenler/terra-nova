<% content_for :title, @alert.title %>

<%= render Ui::BreadcrumbsComponent.new(items: [
      { label: t("agents.nav.dashboard"), path: agents_root_path },
      { label: t("agents.alerts.title"), path: agents_alerts_path },
      { label: @alert.title }
    ]) %>

<div class="mt-4 max-w-3xl">
  <div class="flex flex-wrap items-center justify-between gap-2">
    <h1 class="text-2xl font-bold"><%= @alert.title %></h1>
    <%= render Ui::BadgeComponent.new(label: t("severities.#{@alert.severity}"), variant: severity_badge_variant(@alert.severity)) %>
  </div>
  <p class="mt-2 whitespace-pre-line text-base-content/90"><%= @alert.body %></p>

  <p class="mt-2 text-sm text-base-content/60">
    <%= t("alerts.kinds.#{@alert.kind}") %>
    <% if @alert.locality.present? %> · <%= t("alerts.locality", name: @alert.locality) %><% end %>
  </p>

  <div class="mt-6 flex flex-wrap gap-2">
    <%= link_to t("actions.edit"), edit_agents_alert_path(@alert), class: "btn btn-primary btn-sm" %>
    <%= button_to t("actions.delete"), agents_alert_path(@alert), method: :delete,
          class: "btn btn-error btn-sm", data: { turbo_confirm: t("agents.alerts.confirm_destroy") } %>
  </div>
</div>
