<% content_for :title, t("agents.consultations.title") %>

<%= render Ui::BreadcrumbsComponent.new(items: [
      { label: t("agents.nav.dashboard"), path: agents_root_path },
      { label: t("agents.consultations.title") }
    ]) %>


<%= render Ui::PageHeaderComponent.new(title: t("agents.consultations.title"), subtitle: t("agents.consultations.subtitle")) do %>
    <%= link_to t("agents.consultations.new"), new_agents_consultation_path, class: "btn btn-primary btn-sm" %>
<% end %>

<div class="mt-4 overflow-x-auto rounded-box border border-base-300 bg-base-100">
  <table class="table table-zebra">
    <caption class="sr-only"><%= t("agents.consultations.table_caption") %></caption>
    <thead>
      <tr>
        <th scope="col"><%= t("agents.consultations.columns.title") %></th>
        <th scope="col"><%= t("agents.consultations.columns.kind") %></th>
        <th scope="col"><%= t("agents.consultations.columns.status") %></th>
        <th scope="col"><%= t("agents.consultations.columns.responses") %></th>
        <th scope="col"><span class="sr-only"><%= t("actions.view") %></span></th>
      </tr>
    </thead>
    <tbody>
      <% @consultations.each do |consultation| %>
        <tr>
          <th scope="row"><%= link_to consultation.title, agents_consultation_path(consultation), class: "link" %></th>
          <td><%= t("consultations.kinds.#{consultation.kind}") %></td>
          <td><%= render Ui::BadgeComponent.new(label: t("consultations.status_label.#{consultation.status}"), variant: consultation_status_variant(consultation)) %></td>
          <td><%= consultation.consultation_responses.size %></td>
          <td class="text-right"><%= link_to t("actions.view"), agents_consultation_path(consultation), class: "btn btn-ghost btn-xs" %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
