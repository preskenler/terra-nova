<% content_for :title, @consultation.title %>

<%= render Ui::BreadcrumbsComponent.new(items: [
      { label: t("agents.nav.dashboard"), path: agents_root_path },
      { label: t("agents.consultations.title"), path: agents_consultations_path },
      { label: @consultation.title }
    ]) %>

<div class="mt-4 grid gap-6 lg:grid-cols-3">
  <div class="space-y-4 lg:col-span-2">
    <div class="flex flex-wrap items-center gap-2">
      <h1 class="text-2xl font-bold"><%= @consultation.title %></h1>
      <%= render Ui::BadgeComponent.new(label: t("consultations.kinds.#{@consultation.kind}"), variant: :primary) %>
      <%= render Ui::BadgeComponent.new(label: t("consultations.status_label.#{@consultation.status}"), variant: consultation_status_variant(@consultation)) %>
    </div>
    <p class="whitespace-pre-line text-base-content/90"><%= @consultation.description %></p>

    <section aria-labelledby="results-heading">
      <%= render Ui::SectionHeadingComponent.new(title: t("agents.consultations.results"), id: "results-heading") %>
      <% if @choice_counts.any? %>
        <ul class="mt-2 space-y-1 text-sm">
          <% @choice_counts.each do |choice, count| %>
            <li><strong><%= t("consultations.choices.#{choice}") %></strong> : <%= count %></li>
          <% end %>
        </ul>
      <% else %>
        <p class="mt-2 text-sm text-base-content/60"><%= t("agents.consultations.no_responses") %></p>
      <% end %>
    </section>

    <% if @responses.any? %>
      <section aria-labelledby="responses-heading">
        <%= render Ui::SectionHeadingComponent.new(title: t("agents.consultations.responses"), id: "responses-heading") %>
        <ul class="mt-2 divide-y divide-base-200 rounded-box border border-base-300 bg-base-100">
          <% @responses.each do |response| %>
            <li class="p-3 text-sm">
              <p class="font-mono text-xs text-base-content/60"><%= response.reference %></p>
              <p><strong><%= t("consultations.choices.#{response.choice}") %></strong> — <%= response.user.email %></p>
              <% if response.comment.present? %><p class="text-base-content/80"><%= response.comment %></p><% end %>
            </li>
          <% end %>
        </ul>
      </section>
    <% end %>
  </div>

  <aside class="card border border-base-300 bg-base-100">
    <div class="card-body gap-3">
      <h2 class="card-title text-base"><%= t("agents.consultations.actions_title") %></h2>
      <%= link_to t("actions.edit"), edit_agents_consultation_path(@consultation), class: "btn btn-primary btn-sm" %>
      <%= button_to t("actions.delete"), agents_consultation_path(@consultation), method: :delete,
            class: "btn btn-error btn-sm", data: { turbo_confirm: t("agents.consultations.confirm_destroy") } %>
    </div>
  </aside>
</div>
