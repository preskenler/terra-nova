<% content_for :title, "#{t("agents.users.detail_title")} — #{@user.email}" %>

<%= render Ui::BreadcrumbsComponent.new(items: [
      { label: t("agents.nav.dashboard"), path: agents_root_path },
      { label: t("agents.users.title"), path: agents_users_path },
      { label: @user.email }
    ]) %>

<% if @generated_credentials %>
  <div role="status" class="alert alert-warning mt-4">
    <div>
      <p class="font-semibold"><%= t("agents.users.credentials.title") %></p>
      <p class="text-sm"><%= t("agents.users.credentials.body") %></p>
      <ul class="mt-1 list-disc pl-5 font-mono text-sm">
        <li><%= t("agents.users.credentials.email") %>: <%= @generated_credentials[:email] %></li>
        <li><%= t("agents.users.credentials.login_id") %>: <%= @generated_credentials[:login_id] %></li>
        <li><%= t("agents.users.credentials.password") %>: <%= @generated_credentials[:password] %></li>
      </ul>
      <p class="mt-1 text-xs"><%= t("agents.users.credentials.warning") %></p>
    </div>
  </div>
<% end %>

<div class="mt-4 grid gap-6 lg:grid-cols-3">
  <section class="card border border-base-300 bg-base-100 lg:col-span-2">
    <div class="card-body">
      <h1 class="text-2xl font-bold"><%= @user.email %></h1>

      <dl class="mt-3 grid grid-cols-2 gap-3 text-sm sm:grid-cols-3">
        <div>
          <dt class="text-base-content/60"><%= t("agents.users.columns.role") %></dt>
          <dd class="font-medium"><%= t("roles.#{@user.role}") %></dd>
        </div>
        <div>
          <dt class="text-base-content/60"><%= t("agents.users.columns.locale") %></dt>
          <dd class="font-medium"><%= @user.locale %></dd>
        </div>
        <div>
          <dt class="text-base-content/60"><%= t("agents.users.columns.onboarding") %></dt>
          <dd class="font-medium"><%= @user.onboarding_completed? ? t("common.yes") : t("common.no") %></dd>
        </div>
        <div>
          <dt class="text-base-content/60"><%= t("agents.users.fields.sign_in_count") %></dt>
          <dd class="font-medium"><%= @user.sign_in_count %></dd>
        </div>
        <div>
          <dt class="text-base-content/60"><%= t("agents.users.fields.last_sign_in") %></dt>
          <dd class="font-medium"><%= @user.last_sign_in_at ? l(@user.last_sign_in_at, format: :short) : "—" %></dd>
        </div>
        <div>
          <dt class="text-base-content/60"><%= t("agents.users.fields.failed_attempts") %></dt>
          <dd class="font-medium"><%= @user.failed_attempts %></dd>
        </div>
      </dl>

      <% if @user.profile %>
        <%= render Ui::SectionHeadingComponent.new(title: t("profiles.title")) %>
        <dl class="mt-2 grid grid-cols-2 gap-3 text-sm sm:grid-cols-3">
          <div>
            <dt class="text-base-content/60"><%= t("profiles.fields.address") %></dt>
            <dd><%= @user.profile.address.presence || "—" %></dd>
          </div>
          <div>
            <dt class="text-base-content/60"><%= t("profiles.fields.phone") %></dt>
            <dd><%= @user.profile.phone.presence || "—" %></dd>
          </div>
          <div>
            <dt class="text-base-content/60"><%= t("profiles.fields.city") %></dt>
            <dd><%= @user.profile.city.presence || "—" %></dd>
          </div>
        </dl>
      <% end %>
    </div>
  </section>

  <aside class="card border border-base-300 bg-base-100">
    <div class="card-body gap-3">
      <h2 class="card-title text-base"><%= t("agents.users.actions_title") %></h2>

      <%= link_to t("agents.users.edit"), edit_agents_user_path(@user), class: "btn btn-primary btn-sm" %>

      <% if @user.access_locked? %>
        <%= button_to t("agents.users.unlock"), unlock_agents_user_path(@user), method: :patch,
              class: "btn btn-warning btn-sm" %>
      <% end %>
    </div>
  </aside>
</div>
