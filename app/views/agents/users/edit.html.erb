<% content_for :title, "#{t("agents.users.edit")} — #{@user.email}" %>

<%= render Ui::BreadcrumbsComponent.new(items: [
      { label: t("agents.nav.dashboard"), path: agents_root_path },
      { label: t("agents.users.title"), path: agents_users_path },
      { label: @user.email, path: agents_user_path(@user) },
      { label: t("agents.users.edit") }
    ]) %>

<h1 class="mt-4 text-2xl font-bold"><%= t("agents.users.edit") %></h1>

<%= form_with model: @user, url: agents_user_path(@user), method: :patch, class: "mt-4 max-w-xl space-y-4" do |f| %>
  <div>
    <%= f.label :locale, t("profiles.fields.locale"), class: "mb-1 block text-sm font-medium" %>
    <%= f.select :locale, I18n.available_locales.map { |l| [ t("languages.#{l}"), l ] }, {},
          class: "select select-bordered w-full" %>
  </div>

  <label class="flex cursor-pointer items-center gap-2">
    <%= f.check_box :onboarding_completed, class: "checkbox checkbox-sm" %>
    <span><%= t("agents.users.fields.onboarding_completed") %></span>
  </label>

  <% if current_agent.admin? %>
    <div>
      <%= f.label :role, t("agents.users.columns.role"), class: "mb-1 block text-sm font-medium" %>
      <%= f.select :role, [ [ t("roles.citizen"), "citizen" ], [ t("roles.admin"), "admin" ] ], {},
            class: "select select-bordered w-full" %>
      <p class="mt-1 text-xs text-base-content/60"><%= t("agents.users.role_hint") %></p>
    </div>
  <% end %>

  <div class="flex gap-2">
    <%= f.submit t("actions.save"), class: "btn btn-primary" %>
    <%= link_to t("actions.back"), agents_user_path(@user), class: "btn btn-ghost" %>
  </div>
<% end %>
