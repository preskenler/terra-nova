<% content_for :title, t("agents.users.title") %>

<%= render Ui::BreadcrumbsComponent.new(items: [
      { label: t("agents.nav.dashboard"), path: agents_root_path },
      { label: t("agents.users.title") }
    ]) %>


<%= render Ui::PageHeaderComponent.new(title: t("agents.users.title"), subtitle: t("agents.users.subtitle")) %>

<%= form_with url: agents_users_path, method: :get, class: "mt-4 flex flex-wrap items-end gap-3" do %>
  <div>
    <label for="user-q" class="mb-1 block text-sm font-medium"><%= t("agents.users.search") %></label>
    <%= text_field_tag :q, params[:q], id: "user-q", class: "input input-bordered input-sm" %>
  </div>
  <div>
    <label for="user-role" class="mb-1 block text-sm font-medium"><%= t("agents.users.role") %></label>
    <%= select_tag :role,
          options_for_select([ [ t("agents.users.all"), "" ], [ t("roles.citizen"), "citizen" ], [ t("roles.admin"), "admin" ] ], params[:role]),
          id: "user-role", class: "select select-bordered select-sm" %>
  </div>
  <%= submit_tag t("actions.filter"), class: "btn btn-primary btn-sm" %>
  <%= link_to t("actions.reset"), agents_users_path, class: "btn btn-ghost btn-sm" %>
<% end %>

<div class="mt-4 overflow-x-auto rounded-box border border-base-300 bg-base-100">
  <table class="table table-zebra">
    <caption class="sr-only"><%= t("agents.users.table_caption") %></caption>
    <thead>
      <tr>
        <th scope="col"><%= t("agents.users.columns.email") %></th>
        <th scope="col"><%= t("agents.users.columns.role") %></th>
        <th scope="col"><%= t("agents.users.columns.locale") %></th>
        <th scope="col"><%= t("agents.users.columns.onboarding") %></th>
        <th scope="col"><%= t("agents.users.columns.status") %></th>
        <th scope="col"><span class="sr-only"><%= t("agents.users.columns.actions") %></span></th>
      </tr>
    </thead>
    <tbody>
      <% @users.each do |user| %>
        <tr>
          <th scope="row" class="font-medium"><%= link_to user.email, agents_user_path(user), class: "link" %></th>
          <td><%= render Ui::BadgeComponent.new(label: t("roles.#{user.role}"), variant: user.admin? ? :primary : :neutral) %></td>
          <td><%= user.locale %></td>
          <td><%= user.onboarding_completed? ? t("common.yes") : t("common.no") %></td>
          <td>
            <% if user.access_locked? %>
              <%= render Ui::BadgeComponent.new(label: t("agents.users.locked"), variant: :error) %>
            <% else %>
              <%= render Ui::BadgeComponent.new(label: t("agents.users.active"), variant: :success) %>
            <% end %>
          </td>
          <td class="text-right">
            <%= link_to t("actions.view"), agents_user_path(user), class: "btn btn-ghost btn-xs" %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
<p class="mt-2 text-sm text-base-content/60"><%= t("agents.users.count", count: @total || @users.size) %></p>
<%= render "shared/pagination" %>
