<% content_for :title, t("agents.users.new") %>

<%= render Ui::BreadcrumbsComponent.new(items: [
      { label: t("agents.nav.dashboard"), path: agents_root_path },
      { label: t("agents.users.title"), path: agents_users_path },
      { label: t("agents.users.new") }
    ]) %>

<%= render Ui::PageHeaderComponent.new(title: t("agents.users.new"), subtitle: t("agents.users.new_hint")) %>

<%= form_with model: @user, url: agents_users_path, class: "max-w-xl space-y-4" do |f| %>
  <% if @user.errors.any? %>
    <div role="alert" class="alert alert-error">
      <ul class="list-disc pl-5">
        <% @user.errors.full_messages.each do |message| %><li><%= message %></li><% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= f.label :email, t("agents.users.fields.email_optional"), class: "mb-1 block text-sm font-medium" %>
    <%= f.email_field :email, class: "input input-bordered w-full", autocomplete: "off" %>
    <p class="mt-1 text-xs text-base-content/60"><%= t("agents.users.email_hint") %></p>
  </div>

  <div>
    <%= f.label :login_id, t("agents.users.fields.login_id"), class: "mb-1 block text-sm font-medium" %>
    <%= f.text_field :login_id, class: "input input-bordered w-full", placeholder: "TN-000123" %>
    <p class="mt-1 text-xs text-base-content/60"><%= t("agents.users.login_id_hint") %></p>
  </div>

  <div>
    <%= f.label :locale, t("profiles.fields.locale"), class: "mb-1 block text-sm font-medium" %>
    <%= f.select :locale, I18n.available_locales.map { |l| [ t("languages.#{l}"), l ] }, {}, class: "select select-bordered w-full" %>
  </div>

  <div class="flex gap-2">
    <%= f.submit t("agents.users.create"), class: "btn btn-primary" %>
    <%= link_to t("actions.back"), agents_users_path, class: "btn btn-ghost" %>
  </div>
<% end %>
