<% content_for :title, @idea.reference %>

<%= render Ui::BreadcrumbsComponent.new(items: [
      { label: t("agents.nav.dashboard"), path: agents_root_path },
      { label: t("agents.ideas.title"), path: agents_ideas_path },
      { label: @idea.reference }
    ]) %>

<div class="mt-4 grid gap-6 lg:grid-cols-3">
  <div class="space-y-4 lg:col-span-2">
    <div class="flex flex-wrap items-center justify-between gap-2">
      <div>
        <p class="font-mono text-sm text-base-content/60"><%= @idea.reference %></p>
        <h1 class="text-2xl font-bold"><%= @idea.title %></h1>
      </div>
      <%= render Ui::BadgeComponent.new(label: t("ideas.status.#{@idea.status}"), variant: idea_status_variant(@idea)) %>
    </div>
    <p class="whitespace-pre-line text-base-content/90"><%= @idea.description %></p>
    <p class="text-sm text-base-content/60"><%= t("agents.ideas.author", email: @idea.user.email) %></p>

    <% if @idea.idea_supports.any? %>
      <section aria-labelledby="supporters-heading">
        <h2 id="supporters-heading" class="text-lg font-semibold"><%= t("ideas.supports_title") %></h2>
        <ul class="mt-2 space-y-1 text-sm">
          <% @idea.idea_supports.includes(:user).each do |support| %>
            <li><%= support.user.email %></li>
          <% end %>
        </ul>
      </section>
    <% end %>
  </div>

  <aside class="card border border-base-300 bg-base-100">
    <div class="card-body">
      <h2 class="card-title text-base"><%= t("agents.ideas.moderate") %></h2>
      <%= form_with model: @idea, url: agents_idea_path(@idea), method: :patch, class: "space-y-3" do |f| %>
        <div>
          <%= f.label :status, t("agents.ideas.columns.status"), class: "mb-1 block text-sm font-medium" %>
          <%= f.select :status, Idea::STATUSES.keys.map { |s| [ t("ideas.status.#{s}"), s ] }, {}, class: "select select-bordered select-sm w-full" %>
        </div>
        <div>
          <%= f.label :category, t("ideas.category"), class: "mb-1 block text-sm font-medium" %>
          <%= f.select :category, Idea::CATEGORIES.map { |c| [ t("projects.categories.#{c}"), c ] }, { include_blank: t("agents.ideas.category_none") }, class: "select select-bordered select-sm w-full" %>
        </div>
        <%= f.submit t("actions.save"), class: "btn btn-primary btn-sm w-full" %>
      <% end %>
    </div>
  </aside>
</div>
