<% content_for :title, t("agents.audit_logs.detail_title") %>

<%= render Ui::BreadcrumbsComponent.new(items: [
      { label: t("agents.nav.dashboard"), path: agents_root_path },
      { label: t("agents.audit_logs.title"), path: agents_audit_logs_path },
      { label: "#{@version.item_type} ##{@version.item_id}" }
    ]) %>

<div class="mt-4 max-w-3xl">
  <h1 class="text-2xl font-bold">#<%= @version.id %> — <%= @version.item_type %> #<%= @version.item_id %></h1>

  <dl class="mt-4 grid grid-cols-2 gap-3 text-sm sm:grid-cols-3">
    <div>
      <dt class="text-base-content/60"><%= t("agents.audit_logs.columns.date") %></dt>
      <dd class="font-medium"><%= l(@version.created_at, format: :long) %></dd>
    </div>
    <div>
      <dt class="text-base-content/60"><%= t("agents.audit_logs.columns.actor") %></dt>
      <dd class="font-medium"><%= audit_actor_label(@version.whodunnit) %></dd>
    </div>
    <div>
      <dt class="text-base-content/60"><%= t("agents.audit_logs.columns.event") %></dt>
      <dd class="font-medium"><%= t("agents.audit_logs.events.#{@version.event}", default: @version.event) %></dd>
    </div>
  </dl>

  <section class="mt-6" aria-labelledby="changes-heading">
    <h2 id="changes-heading" class="text-lg font-semibold"><%= t("agents.audit_logs.changes") %></h2>

    <% if @changes.any? %>
      <div class="mt-2 overflow-x-auto rounded-box border border-base-300 bg-base-100">
        <table class="table table-sm">
          <caption class="sr-only"><%= t("agents.audit_logs.changes_caption") %></caption>
          <thead>
            <tr>
              <th scope="col"><%= t("agents.audit_logs.columns.attribute") %></th>
              <th scope="col"><%= t("agents.audit_logs.columns.before") %></th>
              <th scope="col"><%= t("agents.audit_logs.columns.after") %></th>
            </tr>
          </thead>
          <tbody>
            <% @changes.each do |attribute, (before_value, after_value)| %>
              <tr>
                <th scope="row"><%= attribute %></th>
                <td><%= truncate(before_value.inspect, length: 80) %></td>
                <td><%= truncate(after_value.inspect, length: 80) %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <p class="mt-2 text-sm text-base-content/60"><%= t("agents.audit_logs.no_changes") %></p>
    <% end %>
  </section>
</div>
