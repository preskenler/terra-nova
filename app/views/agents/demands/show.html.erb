<% content_for :title, "#{t("agents.demands.detail_title")} #{@demand.request_code}" %>

<%= render Ui::BreadcrumbsComponent.new(items: [
      { label: t("agents.nav.dashboard"), path: agents_root_path },
      { label: t("agents.nav.demands"), path: agents_demands_path },
      { label: @demand.request_code }
    ]) %>

<div class="mt-4 grid gap-6 lg:grid-cols-3">
  <div class="space-y-4 lg:col-span-2">
    <section class="card border border-base-300 bg-base-100">
      <div class="card-body">
        <div class="flex flex-wrap items-center justify-between gap-2">
          <h1 class="font-mono text-2xl font-bold"><%= @demand.request_code %></h1>
          <%= render Ui::BadgeComponent.new(
                label: t("demands.triage.#{@demand.triage_status}"),
                variant: triage_variant(@demand.triage_status)) %>
        </div>

        <p class="mt-2 whitespace-pre-line text-base-content/90"><%= @demand.message_public %></p>

        <dl class="mt-4 grid grid-cols-2 gap-3 text-sm sm:grid-cols-3">
          <div>
            <dt class="text-base-content/60"><%= t("agents.demands.fields.requester") %></dt>
            <dd class="font-medium"><%= @demand.requester_name.presence || "—" %></dd>
          </div>
          <div>
            <dt class="text-base-content/60"><%= t("agents.demands.fields.requester_type") %></dt>
            <dd class="font-medium"><%= @demand.requester_type.presence || "—" %></dd>
          </div>
          <div>
            <dt class="text-base-content/60"><%= t("agents.demands.fields.difficulty") %></dt>
            <dd class="font-medium"><%= @demand.difficulty_label %></dd>
          </div>
          <div>
            <dt class="text-base-content/60"><%= t("agents.demands.fields.xp_base") %></dt>
            <dd class="font-medium"><%= @demand.xp_base %></dd>
          </div>
          <div>
            <dt class="text-base-content/60"><%= t("agents.demands.fields.xp_bonus") %></dt>
            <dd class="font-medium"><%= @demand.xp_time_bonus %></dd>
          </div>
          <div>
            <dt class="text-base-content/60"><%= t("agents.demands.fields.xp_total") %></dt>
            <dd class="font-medium"><%= @demand.xp_total %></dd>
          </div>
          <div>
            <dt class="text-base-content/60"><%= t("agents.demands.fields.wave") %></dt>
            <dd class="font-medium"><%= @demand.wave_number.presence || "—" %></dd>
          </div>
          <div>
            <dt class="text-base-content/60"><%= t("agents.demands.fields.arrival") %></dt>
            <dd class="font-medium"><%= @demand.arrival_time.presence || "—" %></dd>
          </div>
          <div>
            <dt class="text-base-content/60"><%= t("agents.demands.fields.first_seen") %></dt>
            <dd class="font-medium"><%= @demand.first_seen_at ? l(@demand.first_seen_at, format: :short) : "—" %></dd>
          </div>
        </dl>
      </div>
    </section>
  </div>

  <aside class="space-y-4">
    <section class="card border border-base-300 bg-base-100">
      <div class="card-body">
        <h2 class="card-title text-base"><%= t("agents.demands.triage") %></h2>

        <%= form_with model: @demand, url: agents_demand_path(@demand), method: :patch, class: "space-y-3" do |f| %>
          <div>
            <%= f.label :triage_status, t("agents.demands.fields.triage_status"),
                  class: "mb-1 block text-sm font-medium" %>
            <%= f.select :triage_status,
                  Demand::TRIAGE_STATUSES.map { |s| [ t("demands.triage.#{s}"), s ] },
                  {}, class: "select select-bordered select-sm w-full" %>
          </div>

          <div>
            <%= f.label :assignee_id, t("agents.demands.fields.assignee"),
                  class: "mb-1 block text-sm font-medium" %>
            <%= f.collection_select :assignee_id, Agent.order(:email), :id, :email,
                  { include_blank: t("agents.demands.fields.unassigned") },
                  class: "select select-bordered select-sm w-full" %>
          </div>

          <div>
            <%= f.label :notes, t("agents.demands.fields.notes"),
                  class: "mb-1 block text-sm font-medium" %>
            <%= f.text_area :notes, rows: 4, class: "textarea textarea-bordered w-full" %>
          </div>

          <%= f.submit t("actions.save"), class: "btn btn-primary btn-sm w-full" %>
        <% end %>
      </div>
    </section>
  </aside>
</div>
