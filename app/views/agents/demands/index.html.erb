<% content_for :title, t("agents.demands.title") %>

<div data-controller="demand-poller"
     data-demand-poller-url-value="<%= refresh_agents_demands_path %>"
     data-demand-poller-interval-value="30000">
  <div class="flex flex-wrap items-start justify-between gap-3">
    <div>
      <h1 class="text-2xl font-bold"><%= t("agents.demands.title") %></h1>
      <p class="mt-1 text-base-content/70"><%= t("agents.demands.subtitle") %></p>
    </div>
    <div class="flex items-center gap-2">
      <span class="inline-flex items-center gap-1 text-sm text-base-content/70">
        <span aria-hidden="true">&#128260;</span>
        <%= t("agents.demands.auto_refresh") %>
      </span>
      <%= button_to t("agents.demands.refresh"), refresh_agents_demands_path,
            method: :post, class: "btn btn-primary btn-sm" %>
    </div>
  </div>

  <% unless @api_configured %>
    <div role="alert" class="alert alert-warning mt-4">
      <span><%= t("agents.demands.not_configured") %></span>
    </div>
  <% end %>

  <div id="demands-summary" class="mt-4">
    <%= render "agents/demands/summary",
          sync: @sync, unseen_count: @unseen_count, total_count: @total_demands,
          api_configured: @api_configured %>
  </div>

  <div class="mt-4">
    <%= render "agents/demands/filters" %>
  </div>

  <div id="demands-list" class="mt-4">
    <%= render "agents/demands/list", demands: @demands %>
  </div>
</div>
