<% content_for :title, t("agents.security_events.title") %>

<%= render Ui::BreadcrumbsComponent.new(items: [
      { label: t("agents.nav.dashboard"), path: agents_root_path },
      { label: t("agents.security_events.title") }
    ]) %>

<%= render Ui::PageHeaderComponent.new(title: t("agents.security_events.title"), subtitle: t("agents.security_events.subtitle")) %>

<%= form_with url: agents_security_events_path, method: :get, class: "mb-4 flex flex-wrap items-end gap-3" do %>
  <div>
    <label for="event" class="mb-1 block text-sm font-medium"><%= t("agents.security_events.event") %></label>
    <%= select_tag :event,
          options_for_select([ [ t("agents.security_events.all"), "" ] ] + @event_types.map { |e| [ t("agents.security_events.events.#{e}", default: e), e ] }, params[:event]),
          id: "event", class: "select select-bordered select-sm" %>
  </div>
  <%= submit_tag t("actions.filter"), class: "btn btn-primary btn-sm" %>
  <%= link_to t("actions.reset"), agents_security_events_path, class: "btn btn-ghost btn-sm" %>
<% end %>

<div class="overflow-x-auto rounded-box border border-base-300 bg-base-100">
  <table class="table table-zebra">
    <caption class="sr-only"><%= t("agents.security_events.table_caption") %></caption>
    <thead>
      <tr>
        <th scope="col"><%= t("agents.security_events.columns.date") %></th>
        <th scope="col"><%= t("agents.security_events.columns.event") %></th>
        <th scope="col"><%= t("agents.security_events.columns.actor") %></th>
        <th scope="col"><%= t("agents.security_events.columns.ip") %></th>
      </tr>
    </thead>
    <tbody>
      <% @events.each do |event| %>
        <tr>
          <th scope="row" class="whitespace-nowrap"><%= l(event.created_at, format: :short) %></th>
          <td><%= t("agents.security_events.events.#{event.event}", default: event.event) %></td>
          <td><%= event.actor_type.present? ? "#{event.actor_type} ##{event.actor_id}" : "—" %></td>
          <td class="font-mono text-xs"><%= event.ip || "—" %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
