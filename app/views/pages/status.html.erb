<% content_for :title, t("status.title") %>

<%= render Ui::BreadcrumbsComponent.new(items: [
      { label: t("nav.home"), path: root_path },
      { label: t("status.title") }
    ]) %>

<%= render Ui::PageHeaderComponent.new(title: t("status.title"), subtitle: t("status.subtitle")) %>

<% unless @database_ok && @cache_ok %>
  <%= render "shared/essentials_strip" %>
<% end %>

<div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
  <%= render Ui::StatComponent.new(
        label: t("status.database"),
        value: @database_ok ? t("status.up") : t("status.down")) %>
  <%= render Ui::StatComponent.new(
        label: t("status.cache"),
        value: @cache_ok ? t("status.up") : t("status.down")) %>
  <%= render Ui::StatComponent.new(
        label: t("status.current_wave"),
        value: @last_sync&.current_wave || "—") %>
  <%= render Ui::StatComponent.new(
        label: t("status.last_sync"),
        value: @last_sync ? l(@last_sync.fetched_at, format: :short) : t("status.never")) %>
</div>

<section class="mt-6" aria-labelledby="status-counts-heading">
  <%= render Ui::SectionHeadingComponent.new(title: t("status.counts"), id: "status-counts-heading") %>
  <div class="grid gap-4 sm:grid-cols-3">
    <%= render Ui::StatComponent.new(label: t("status.services"), value: @counts[:services]) %>
    <%= render Ui::StatComponent.new(label: t("status.requests"), value: @counts[:requests]) %>
    <%= render Ui::StatComponent.new(label: t("status.demands"), value: @counts[:demands]) %>
  </div>
</section>
