<% content_for :title, t("pages.accessibility.title") %>

<%= render Ui::BreadcrumbsComponent.new(items: [
      { label: t("nav.home"), path: root_path },
      { label: t("pages.accessibility.title") }
    ]) %>

<article class="mt-4 max-w-3xl space-y-4">
  <h1 class="text-2xl font-bold"><%= t("pages.accessibility.title") %></h1>
  <p class="text-base-content/80"><%= t("pages.accessibility.intro") %></p>

  <section aria-labelledby="a11y-features-heading">
    <%= render Ui::SectionHeadingComponent.new(title: t("pages.accessibility.features_heading"), id: "a11y-features-heading") %>
    <ul class="mt-2 list-disc space-y-1 pl-5 text-base-content/80">
      <% %i[keyboard contrast text screen_reader motion].each do |feature| %>
        <li><%= t("pages.accessibility.features.#{feature}") %></li>
      <% end %>
    </ul>
  </section>

  <section>
    <%= render Ui::SectionHeadingComponent.new(title: t("pages.accessibility.help_heading")) %>
    <p class="mt-1 text-base-content/80"><%= t("pages.accessibility.help_body") %></p>
    <%= link_to t("pages.accessibility.contact"), new_feedback_path, class: "btn btn-primary btn-sm mt-2" %>
  </section>
</article>
