<% content_for :title, t("pages.eco.title") %>

<%= render Ui::BreadcrumbsComponent.new(items: [
      { label: t("nav.home"), path: root_path },
      { label: t("pages.eco.title") }
    ]) %>

<article class="mt-4 max-w-3xl space-y-6">
  <header>
    <h1 class="text-2xl font-bold"><%= t("pages.eco.title") %></h1>
    <p class="mt-1 text-base-content/80"><%= t("pages.eco.intro") %></p>
  </header>

  <section aria-labelledby="eco-metrics-heading">
    <h2 id="eco-metrics-heading" class="text-lg font-semibold"><%= t("pages.eco.metrics_heading") %></h2>
    <div class="mt-3 grid gap-4 sm:grid-cols-2">
      <%= render Ui::StatComponent.new(
            label: t("pages.eco.css"),
            value: number_to_human_size(@report[:css_bytes]),
            hint: t("pages.eco.budget", value: number_to_human_size(@report[:css_budget]))) %>
      <%= render Ui::StatComponent.new(
            label: t("pages.eco.js"),
            value: number_to_human_size(@report[:js_bytes]),
            hint: t("pages.eco.budget", value: number_to_human_size(@report[:js_budget]))) %>
    </div>
    <p class="mt-2 text-sm text-base-content/60"><%= t("pages.eco.measured_note") %></p>
  </section>

  <section aria-labelledby="eco-choices-heading">
    <h2 id="eco-choices-heading" class="text-lg font-semibold"><%= t("pages.eco.choices_heading") %></h2>
    <ul class="mt-2 list-disc space-y-1 pl-5 text-base-content/80">
      <% %i[no_framework maps_lazy low_data no_fonts budget].each do |choice| %>
        <li><%= t("pages.eco.choices.#{choice}") %></li>
      <% end %>
    </ul>
  </section>

  <section>
    <h2 class="text-lg font-semibold"><%= t("pages.eco.low_data_heading") %></h2>
    <p class="mt-1 text-base-content/80"><%= t("pages.eco.low_data_body") %></p>
    <p class="mt-2 text-sm">
      <%= link_to t("a11y.controls"), "#", class: "link" %>
    </p>
  </section>
</article>
