<% content_for :title, t("essentials.title") %>

<%= render Ui::BreadcrumbsComponent.new(items: [
      { label: t("nav.home"), path: root_path },
      { label: t("essentials.title") }
    ]) %>

<%= render Ui::PageHeaderComponent.new(title: t("essentials.title"), subtitle: t("essentials.subtitle")) %>

<section aria-labelledby="essentials-emergency-heading">
  <%= render Ui::SectionHeadingComponent.new(title: t("essentials.emergency.heading"), id: "essentials-emergency-heading") %>
  <ul class="mt-3 grid gap-3 sm:grid-cols-2 lg:grid-cols-4" role="list">
    <% @information[:emergency_services].each do |item| %>
      <li class="rounded-box border border-base-300 bg-base-100 p-4">
        <p class="text-sm text-base-content/70"><%= item[:name] %></p>
        <p class="text-2xl font-bold" aria-label="<%= item[:name] %>">
          <a class="link" href="tel:<%= item[:phone] %>"><%= item[:phone] %></a>
        </p>
      </li>
    <% end %>
  </ul>
</section>

<section class="mt-6" aria-labelledby="essentials-procedures-heading">
  <%= render Ui::SectionHeadingComponent.new(title: t("essentials.procedures.heading"), id: "essentials-procedures-heading") %>
  <% if @information[:procedures].any? %>
    <ul class="mt-3 space-y-2">
      <% @information[:procedures].each do |procedure| %>
        <li class="flex flex-wrap items-center justify-between gap-2 rounded-box border border-base-300 bg-base-100 p-3 text-sm">
          <span><%= link_to procedure[:name], service_path(procedure[:slug]), class: "link font-medium" %></span>
          <% if procedure[:phone].present? %>
            <a class="link" href="tel:<%= procedure[:phone] %>"><%= procedure[:phone] %></a>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="mt-3 text-sm text-base-content/60"><%= t("essentials.procedures.unavailable") %></p>
  <% end %>
</section>

<section class="mt-6" aria-labelledby="essentials-alerts-heading">
  <%= render Ui::SectionHeadingComponent.new(title: t("essentials.alerts.heading"), id: "essentials-alerts-heading") %>
  <% if @information[:alerts].any? %>
    <div class="mt-3 space-y-3">
      <% @information[:alerts].each do |alert| %>
        <div role="status" class="alert <%= severity_alert_class(alert[:severity]) %>">
          <div>
            <p class="font-semibold"><%= alert[:title] %></p>
            <p class="text-sm"><%= alert[:body] %></p>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <p class="mt-3 text-sm text-base-content/60"><%= t("essentials.alerts.none") %></p>
  <% end %>
</section>

<p class="mt-6 text-sm text-base-content/60"><%= t("essentials.footer_note") %></p>
