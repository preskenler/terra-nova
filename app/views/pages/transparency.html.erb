<% content_for :title, t("pages.transparency.title") %>

<%= render Ui::BreadcrumbsComponent.new(items: [
      { label: t("nav.home"), path: root_path },
      { label: t("pages.transparency.title") }
    ]) %>

<article class="mt-4 max-w-3xl space-y-4">
  <h1 class="text-2xl font-bold"><%= t("pages.transparency.title") %></h1>
  <p class="text-base-content/80"><%= t("pages.transparency.intro") %></p>

  <section>
    <%= render Ui::SectionHeadingComponent.new(title: t("pages.transparency.how_heading")) %>
    <p class="mt-1 text-base-content/80"><%= t("pages.transparency.how_body") %></p>
  </section>

  <section>
    <%= render Ui::SectionHeadingComponent.new(title: t("pages.transparency.rights_heading")) %>
    <p class="mt-1 text-base-content/80"><%= t("pages.transparency.rights_body") %></p>
  </section>

  <section aria-labelledby="concern-heading">
    <%= render Ui::SectionHeadingComponent.new(title: t("pages.transparency.concern_heading"), id: "concern-heading") %>
    <p class="mt-1 text-base-content/80"><%= t("pages.transparency.concern_body") %></p>
    <%= link_to t("pages.transparency.contact"),
          new_feedback_path(kind: "data_concern"), class: "btn btn-primary btn-sm mt-2" %>
  </section>
</article>
