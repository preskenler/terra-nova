<% content_for :title, t("appointments.new") %>

<%= render Ui::BreadcrumbsComponent.new(items: [
      { label: t("nav.home"), path: root_path },
      { label: t("nav.my_space"), path: citizen_dashboard_path },
      { label: t("appointments.title"), path: appointments_path },
      { label: t("appointments.new") }
    ]) %>

<h1 class="mt-4 text-2xl font-bold"><%= t("appointments.new") %></h1>
<p class="mt-1 max-w-2xl text-base-content/70"><%= t("appointments.form.intro") %></p>

<%= form_with url: new_appointment_path, method: :get, class: "mt-4 flex flex-wrap items-end gap-3" do %>
  <div>
    <label for="agent_id" class="mb-1 block text-sm font-medium"><%= t("appointments.form.agent") %></label>
    <%= select_tag :agent_id,
          options_for_select(@agents.map { |a| [ a.display_name, a.id ] }, @agent&.id),
          id: "agent_id", class: "select select-bordered select-sm" %>
  </div>
  <div>
    <label for="date" class="mb-1 block text-sm font-medium"><%= t("appointments.form.date") %></label>
    <%= date_field_tag :date, @date, id: "date", class: "input input-bordered input-sm" %>
  </div>
  <%= submit_tag t("appointments.form.show_slots"), class: "btn btn-primary btn-sm" %>
<% end %>

<% if @agent && @slots.any? %>
  <%= form_with url: appointments_path, class: "mt-6 max-w-2xl space-y-4" do %>
    <%= hidden_field_tag "appointment[agent_id]", @agent.id %>

    <fieldset class="rounded-box border border-base-300 bg-base-100 p-4">
      <legend class="px-1 text-sm font-medium">
        <%= t("appointments.form.slots_for", date: l(@date, format: :long), agent: @agent.display_name) %>
      </legend>

      <div class="mt-2 flex flex-wrap gap-2">
        <% @slots.each_with_index do |slot, index| %>
          <div class="flex items-center gap-2 rounded-box border border-base-300 px-3 py-2">
            <%= radio_button_tag "appointment[starts_at]", slot.iso8601, false,
                  id: "slot_#{index}", class: "radio radio-primary radio-sm" %>
            <%= label_tag "slot_#{index}", l(slot, format: :time), class: "text-sm" %>
          </div>
        <% end %>
      </div>
    </fieldset>

    <div>
      <label for="appointment_service_id" class="mb-1 block text-sm font-medium"><%= t("appointments.form.service") %></label>
      <%= select_tag "appointment[service_id]",
            options_for_select(@services.map { |s| [ s.name, s.id ] }, nil),
            include_blank: t("appointments.form.service_none"),
            id: "appointment_service_id", class: "select select-bordered w-full" %>
    </div>

    <div>
      <label for="appointment_notes" class="mb-1 block text-sm font-medium"><%= t("appointments.form.notes") %></label>
      <%= text_area_tag "appointment[notes]", nil, id: "appointment_notes", rows: 3,
            class: "textarea textarea-bordered w-full" %>
      <p class="mt-1 text-xs text-base-content/60"><%= t("appointments.form.notes_hint") %></p>
    </div>

    <%= submit_tag t("appointments.form.book"), class: "btn btn-primary" %>
  <% end %>
<% else %>
  <div class="mt-6 max-w-2xl">
    <%= render Ui::EmptyStateComponent.new(
          title: t("appointments.form.no_slots"),
          description: t("appointments.form.no_slots_hint")) %>
  </div>
<% end %>
