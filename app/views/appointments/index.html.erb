<% content_for :title, t("appointments.title") %>

<%= render Ui::BreadcrumbsComponent.new(items: [
      { label: t("nav.home"), path: root_path },
      { label: t("nav.my_space"), path: citizen_dashboard_path },
      { label: t("appointments.title") }
    ]) %>

<div class="mt-4 flex flex-wrap items-start justify-between gap-3">
  <div>
    <h1 class="text-2xl font-bold"><%= t("appointments.title") %></h1>
    <p class="mt-1 text-base-content/70"><%= t("appointments.subtitle") %></p>
  </div>
  <%= link_to t("appointments.new"), new_appointment_path, class: "btn btn-primary" %>
</div>

<% if @appointments.any? %>
  <ul class="mt-6 space-y-3">
    <% @appointments.each do |appointment| %>
      <li class="rounded-box border border-base-300 bg-base-100 p-4">
        <div class="flex flex-wrap items-start justify-between gap-2">
          <div>
            <p class="font-semibold"><%= l(appointment.starts_at, format: :long) %></p>
            <p class="text-sm text-base-content/70">
              <%= t("appointments.with", agent: appointment.agent.display_name) %>
              <% if appointment.service %><span aria-hidden="true"> · </span><%= appointment.service.name %><% end %>
            </p>
          </div>
          <div class="flex items-center gap-2">
            <%= render Ui::BadgeComponent.new(
                  label: t("appointments.status.#{appointment.status}"),
                  variant: appointment_badge_variant(appointment.status)) %>
            <%= link_to t("actions.view"), appointment_path(appointment), class: "btn btn-ghost btn-xs" %>
          </div>
        </div>
      </li>
    <% end %>
  </ul>
<% else %>
  <div class="mt-6">
    <%= render Ui::EmptyStateComponent.new(
          title: t("appointments.empty"),
          description: t("appointments.empty_hint")) do %>
      <%= link_to t("appointments.new"), new_appointment_path, class: "btn btn-primary btn-sm" %>
    <% end %>
  </div>
<% end %>
