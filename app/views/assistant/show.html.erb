<% content_for :title, t("assistant.title") %>

<%= render Ui::BreadcrumbsComponent.new(items: [
      { label: t("nav.home"), path: root_path },
      { label: t("assistant.title") }
    ]) %>

<%= render Ui::PageHeaderComponent.new(title: t("assistant.title"), subtitle: t("assistant.subtitle")) %>

<%= form_with url: assistant_path, method: :get, class: "mt-4 max-w-2xl" do %>
  <label for="assistant-q" class="mb-1 block text-sm font-medium"><%= t("assistant.label") %></label>
  <div class="flex flex-wrap gap-2">
    <%= text_field_tag :q, @query, id: "assistant-q", class: "input input-bordered w-full sm:flex-1",
          placeholder: t("assistant.placeholder"), autocomplete: "off" %>
    <%= submit_tag t("assistant.submit"), class: "btn btn-primary" %>
  </div>
  <p class="mt-2 text-xs text-base-content/60"><%= t("assistant.hint") %></p>
<% end %>

<% unless @query.present? %>
  <p class="mt-4 text-sm text-base-content/70">
    <%= t("assistant.examples") %>
    <% @examples.each do |example| %>
      <span class="badge badge-ghost badge-sm"><%= example %></span>
    <% end %>
  </p>
<% end %>

<% if @result %>
  <section class="mt-6" aria-labelledby="assistant-results-heading">
    <%= render Ui::SectionHeadingComponent.new(title: t("assistant.results.heading"), id: "assistant-results-heading") %>

    <% if @result[:services].any? %>
      <ul class="mt-3 space-y-2">
        <% @result[:services].each do |service| %>
          <li class="rounded-box border border-base-300 bg-base-100 p-3">
            <p class="font-medium"><%= link_to service.name, service_path(service), class: "link" %></p>
            <p class="mt-1 text-sm text-base-content/70"><%= truncate(service.plain_language.presence || service.description.to_s, length: 140) %></p>
          </li>
        <% end %>
      </ul>

      <% if @result[:suggested_step] %>
        <p class="mt-3 text-sm"><%= t("assistant.results.next_step") %></p>
        <%= link_to t("assistant.results.start"),
              new_request_path(subject: t("assistant.suggested_subject"), service_id: @result[:services].first&.id),
              class: "btn btn-primary btn-sm mt-2" %>
      <% end %>
    <% else %>
      <%= render Ui::EmptyStateComponent.new(
            title: t("assistant.results.empty"),
            description: t("assistant.results.empty_hint")) do %>
        <%= link_to t("nav.contact"), new_feedback_path, class: "btn btn-primary btn-sm" %>
      <% end %>
    <% end %>
  </section>
<% end %>
