<% content_for :title, @consultation.title %>

<%= render Ui::BreadcrumbsComponent.new(items: [
      { label: t("nav.home"), path: root_path },
      ({ label: @consultation.project.name, path: project_path(@consultation.project) } if @consultation.project),
      { label: @consultation.title }
    ].compact) %>

<div class="mt-4 max-w-3xl">
  <div class="flex flex-wrap items-center gap-2">
    <h1 class="text-2xl font-bold"><%= @consultation.title %></h1>
    <%= render Ui::BadgeComponent.new(label: t("consultations.kinds.#{@consultation.kind}"), variant: :primary) %>
    <%= render Ui::BadgeComponent.new(label: t("consultations.status_label.#{@consultation.status}"), variant: consultation_status_variant(@consultation)) %>
  </div>

  <p class="mt-3 whitespace-pre-line text-base-content/90"><%= @consultation.description %></p>

  <section class="mt-6 rounded-box border border-base-300 bg-base-100 p-4" aria-labelledby="participate-heading">
    <%= render Ui::SectionHeadingComponent.new(title: t("consultations.participate"), id: "participate-heading") %>

    <% if user_signed_in? %>
      <% if @response %>
        <div role="status" class="alert alert-success mt-2">
          <div>
            <p><%= t("consultations.already_responded", reference: @response.reference) %></p>
            <p class="text-sm"><%= t("consultations.your_choice", choice: t("consultations.choices.#{@response.choice}")) %></p>
          </div>
        </div>
        <% if @response.comment.present? %>
          <p class="mt-2 text-sm text-base-content/80"><%= @response.comment %></p>
        <% end %>
      <% elsif @consultation.open_for_response? %>
        <%= form_with url: consultation_response_path(@consultation), method: :post, class: "mt-3 space-y-3" do %>
          <fieldset>
            <legend class="text-sm font-medium"><%= t("consultations.your_opinion") %></legend>
            <div class="mt-2 space-y-2">
              <% %i[favorable unfavorable no_opinion].each do |choice| %>
                <label class="flex cursor-pointer items-center gap-2">
                  <%= radio_button_tag "consultation_response[choice]", choice, false, id: "choice_#{choice}", class: "radio radio-primary radio-sm" %>
                  <span><%= t("consultations.choices.#{choice}") %></span>
                </label>
              <% end %>
            </div>
          </fieldset>

          <div>
            <label for="consultation_response_comment" class="mb-1 block text-sm font-medium"><%= t("consultations.comment") %></label>
            <%= text_area_tag "consultation_response[comment]", nil, id: "consultation_response_comment",
                  rows: 3, class: "textarea textarea-bordered w-full" %>
          </div>

          <%= submit_tag t("consultations.submit"), class: "btn btn-primary" %>
        <% end %>
      <% else %>
        <div role="status" class="alert alert-info mt-2">
          <span><%= t("consultations.closed") %></span>
        </div>
      <% end %>
    <% else %>
      <p class="mt-2 text-sm text-base-content/80">
        <%= link_to t("nav.sign_in"), new_user_session_path, class: "link" %>
        <%= t("consultations.sign_in_to_participate") %>
      </p>
    <% end %>
  </section>
</div>
