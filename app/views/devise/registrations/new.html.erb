<% content_for :title, t("auth.registrations.title") %>

<%= render layout: "devise/shared/auth_shell", locals: {
      eyebrow: t("auth.citizen_space"),
      title: t("auth.registrations.title"),
      subtitle: t("auth.registrations.subtitle")
    } do %>
  <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "space-y-4" }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>

    <div class="auth-field">
      <%= f.label :email, t("auth.fields.email"), class: "text-sm font-semibold" %>
      <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "input input-bordered w-full" %>
    </div>

    <div class="auth-field">
      <%= f.label :password, t("auth.fields.password"), class: "text-sm font-semibold" %>
      <% if @minimum_password_length %>
        <p class="text-xs text-base-content/60"><%= t("auth.fields.password_hint", count: @minimum_password_length) %></p>
      <% end %>
      <%= f.password_field :password, autocomplete: "new-password", class: "input input-bordered w-full" %>
    </div>

    <div class="auth-field">
      <%= f.label :password_confirmation, t("auth.fields.password_confirmation"), class: "text-sm font-semibold" %>
      <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "input input-bordered w-full" %>
    </div>

    <%= f.submit t("auth.registrations.submit"), class: "btn btn-primary w-full" %>
  <% end %>

  <div class="mt-5"><%= render "devise/shared/links" %></div>
<% end %>
