<section class="mx-auto grid w-full max-w-4xl overflow-hidden rounded-box border border-base-300 bg-base-100 md:grid-cols-[2fr_3fr]">
  <aside class="flex flex-col justify-between gap-10 bg-base-content p-8 text-base-100 md:p-12">
    <%= link_to root_path, aria: { label: t("app.name") } do %>
      <%= image_tag "/logo.webp", class: "size-16 rounded-full border border-base-100/25 object-cover", alt: "" %>
    <% end %>

    <div>
      <p class="text-xs font-bold uppercase tracking-widest opacity-70"><%= t("app.name") %></p>
      <p class="mt-3 text-xl font-bold leading-tight"><%= t("auth.aside.title") %></p>
      <p class="mt-3 text-sm leading-relaxed opacity-70"><%= t("auth.aside.body") %></p>
    </div>
  </aside>

  <div class="flex flex-col justify-center p-8 md:p-12">
    <p class="text-xs font-bold uppercase tracking-widest text-base-content"><%= eyebrow %></p>
    <h1 class="mt-2 text-2xl font-bold tracking-tight"><%= title %></h1>
    <% if local_assigns[:subtitle].present? %>
      <p class="mt-2 text-sm leading-relaxed text-base-content/65"><%= subtitle %></p>
    <% end %>
    <div class="mt-6"><%= yield %></div>
  </div>
</section>
