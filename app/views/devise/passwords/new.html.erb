<% content_for :title, t("auth.passwords.forgot_title") %>

<%= render layout: "devise/shared/auth_shell", locals: {
      eyebrow: resource_name == :agent ? t("auth.agent_space") : t("auth.citizen_space"),
      title: t("auth.passwords.forgot_title"),
      subtitle: t("auth.passwords.forgot_subtitle")
    } do %>
  <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post, class: "space-y-4" }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>
    <div class="auth-field">
      <%= f.label :email, t("auth.fields.email"), class: "text-sm font-semibold" %>
      <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "input input-bordered w-full" %>
    </div>
    <%= f.submit t("auth.passwords.send"), class: "btn btn-primary w-full" %>
  <% end %>
  <div class="mt-5"><%= render "devise/shared/links" %></div>
<% end %>
