<% content_for :title, t("auth.passwords.edit_title") %>

<%= render layout: "devise/shared/auth_shell", locals: {
      eyebrow: resource_name == :agent ? t("auth.agent_space") : t("auth.citizen_space"),
      title: t("auth.passwords.edit_title"),
      subtitle: t("auth.passwords.edit_subtitle")
    } do %>
  <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put, class: "space-y-4" }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>
    <%= f.hidden_field :reset_password_token %>
    <div class="auth-field">
      <%= f.label :password, t("auth.fields.new_password"), class: "text-sm font-semibold" %>
      <% if @minimum_password_length %>
        <p class="text-xs text-base-content/60"><%= t("auth.fields.password_hint", count: @minimum_password_length) %></p>
      <% end %>
      <%= f.password_field :password, autofocus: true, autocomplete: "new-password", class: "input input-bordered w-full" %>
    </div>
    <div class="auth-field">
      <%= f.label :password_confirmation, t("auth.fields.password_confirmation"), class: "text-sm font-semibold" %>
      <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "input input-bordered w-full" %>
    </div>
    <%= f.submit t("auth.passwords.update"), class: "btn btn-primary w-full" %>
  <% end %>
<% end %>
