<% content_for :title, @project.name %>

<%= render Ui::BreadcrumbsComponent.new(items: [
      { label: t("nav.home"), path: root_path },
      { label: t("projects.title"), path: projects_path },
      { label: @project.name }
    ]) %>

<div class="mt-4 grid gap-6 lg:grid-cols-3">
  <div class="space-y-4 lg:col-span-2">
    <div class="flex flex-wrap items-center justify-between gap-2">
      <h1 class="text-2xl font-bold"><%= @project.name %></h1>
      <%= render Ui::BadgeComponent.new(label: t("projects.status.#{@project.status}"), variant: project_status_variant(@project)) %>
    </div>

    <p class="whitespace-pre-line text-base-content/90"><%= @project.description %></p>

    <dl class="grid grid-cols-2 gap-3 text-sm sm:grid-cols-3">
      <% if @project.category.present? %>
        <div>
          <dt class="text-base-content/60"><%= t("projects.category") %></dt>
          <dd class="font-medium"><%= t("projects.categories.#{@project.category}") %></dd>
        </div>
      <% end %>
      <% if @project.starts_on.present? %>
        <div>
          <dt class="text-base-content/60"><%= t("projects.starts_on") %></dt>
          <dd class="font-medium"><%= l(@project.starts_on, format: :long) %></dd>
        </div>
      <% end %>
      <% if @project.ends_on.present? %>
        <div>
          <dt class="text-base-content/60"><%= t("projects.ends_on") %></dt>
          <dd class="font-medium"><%= l(@project.ends_on, format: :long) %></dd>
        </div>
      <% end %>
    </dl>
  </div>

  <aside class="space-y-4">
    <section class="card border border-base-300 bg-base-100">
      <div class="card-body">
        <h2 class="card-title text-base"><%= t("consultations.title") %></h2>
        <% if @consultations.any? %>
          <ul class="space-y-3 text-sm">
            <% @consultations.each do |consultation| %>
              <li>
                <p class="font-medium"><%= link_to consultation.title, consultation_path(consultation), class: "link" %></p>
                <p class="mt-1">
                  <%= render Ui::BadgeComponent.new(label: t("consultations.status_label.#{consultation.status}"), variant: consultation_status_variant(consultation)) %>
                </p>
              </li>
            <% end %>
          </ul>
        <% else %>
          <p class="text-sm text-base-content/60"><%= t("consultations.none") %></p>
        <% end %>
      </div>
    </section>
  </aside>
</div>
