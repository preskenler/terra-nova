<% content_for :title, t("projects.title") %>

<%= render Ui::BreadcrumbsComponent.new(items: [
      { label: t("nav.home"), path: root_path },
      { label: t("projects.title") }
    ]) %>

<h1 class="mt-4 text-2xl font-bold"><%= t("projects.title") %></h1>
<p class="mt-1 max-w-2xl text-base-content/70"><%= t("projects.subtitle") %></p>

<% if @ongoing.any? %>
  <section class="mt-6" aria-labelledby="ongoing-projects-heading">
    <h2 id="ongoing-projects-heading" class="text-lg font-bold"><%= t("projects.ongoing") %></h2>
    <div class="mt-3 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
      <% @ongoing.each do |project| %>
        <article class="card border border-base-300 bg-base-100">
          <div class="card-body gap-2">
            <div class="flex flex-wrap items-start justify-between gap-2">
              <h3 class="card-title text-base">
                <%= link_to project.name, project_path(project), class: "link link-hover" %>
              </h3>
              <%= render Ui::BadgeComponent.new(label: t("projects.status.#{project.status}"), variant: project_status_variant(project)) %>
            </div>
            <p class="text-sm text-base-content/80"><%= truncate(project.description.to_s, length: 130) %></p>
          </div>
        </article>
      <% end %>
    </div>
  </section>
<% end %>

<section class="mt-6" aria-labelledby="all-projects-heading">
  <h2 id="all-projects-heading" class="text-lg font-bold"><%= t("projects.all") %></h2>
  <% if @projects.any? %>
    <ul class="mt-3 divide-y divide-base-200 rounded-box border border-base-300 bg-base-100">
      <% @projects.each do |project| %>
        <li class="flex flex-wrap items-center justify-between gap-2 p-4">
          <div class="min-w-0">
            <p class="font-medium"><%= link_to project.name, project_path(project), class: "link" %></p>
            <p class="text-sm text-base-content/60"><%= t("projects.categories.#{project.category}") if project.category.present? %></p>
          </div>
          <%= render Ui::BadgeComponent.new(label: t("projects.status.#{project.status}"), variant: project_status_variant(project)) %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <div class="mt-3">
      <%= render Ui::EmptyStateComponent.new(title: t("projects.empty")) %>
    </div>
  <% end %>
</section>
