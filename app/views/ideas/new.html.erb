<% content_for :title, t("ideas.new") %>

<%= render Ui::BreadcrumbsComponent.new(items: [
      { label: t("nav.home"), path: root_path },
      { label: t("ideas.title"), path: ideas_path },
      { label: t("ideas.new") }
    ]) %>

<%= render Ui::PageHeaderComponent.new(title: t("ideas.new"), subtitle: t("ideas.form.intro")) %>

<%= form_with model: @idea, url: ideas_path, class: "mt-6 max-w-2xl space-y-4" do |f| %>
  <% if @idea.errors.any? %>
    <div role="alert" class="alert alert-error">
      <ul class="list-disc pl-5">
        <% @idea.errors.full_messages.each do |message| %><li><%= message %></li><% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= f.label :title, t("ideas.fields.title"), class: "mb-1 block text-sm font-medium" %>
    <%= f.text_field :title, class: "input input-bordered w-full", maxlength: 150 %>
  </div>

  <div>
    <%= f.label :category, t("ideas.fields.category"), class: "mb-1 block text-sm font-medium" %>
    <%= f.select :category, Idea::CATEGORIES.map { |c| [ t("projects.categories.#{c}"), c ] }, { include_blank: t("ideas.fields.category_none") },
          class: "select select-bordered w-full" %>
  </div>

  <div>
    <%= f.label :description, t("ideas.fields.description"), class: "mb-1 block text-sm font-medium" %>
    <%= f.text_area :description, rows: 6, class: "textarea textarea-bordered w-full" %>
  </div>

  <div class="flex gap-2">
    <%= f.submit t("ideas.form.submit"), class: "btn btn-primary" %>
    <%= link_to t("actions.back"), ideas_path, class: "btn btn-ghost" %>
  </div>
<% end %>
