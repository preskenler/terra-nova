<% content_for :title, t("ideas.title") %>

<%= render Ui::BreadcrumbsComponent.new(items: [
      { label: t("nav.home"), path: root_path },
      { label: t("ideas.title") }
    ]) %>

<div class="mt-4 flex flex-wrap items-start justify-between gap-3">
  <div>
    <h1 class="text-2xl font-bold"><%= t("ideas.title") %></h1>
    <p class="mt-1 text-base-content/70"><%= t("ideas.subtitle") %></p>
  </div>
  <%= link_to t("ideas.new"), new_idea_path, class: "btn btn-primary" %>
</div>

<% if @ideas.any? %>
  <ul class="mt-6 space-y-3">
    <% @ideas.each do |idea| %>
      <li class="rounded-box border border-base-300 bg-base-100 p-4">
        <div class="flex flex-wrap items-start justify-between gap-2">
          <div class="min-w-0">
            <p class="font-mono text-xs text-base-content/60"><%= idea.reference %></p>
            <h2 class="text-lg font-semibold"><%= link_to idea.title, idea_path(idea), class: "link link-hover" %></h2>
            <p class="mt-1 text-sm text-base-content/70"><%= truncate(idea.description, length: 160) %></p>
          </div>
          <div class="flex flex-col items-end gap-1">
            <%= render Ui::BadgeComponent.new(label: t("ideas.status.#{idea.status}"), variant: idea_status_variant(idea)) %>
            <span class="text-xs text-base-content/60"><%= t("ideas.supports_count", count: idea.support_count) %></span>
          </div>
        </div>
      </li>
    <% end %>
  </ul>
<% else %>
  <div class="mt-6">
    <%= render Ui::EmptyStateComponent.new(title: t("ideas.empty"), description: t("ideas.empty_hint")) do %>
      <%= link_to t("ideas.new"), new_idea_path, class: "btn btn-primary btn-sm" %>
    <% end %>
  </div>
<% end %>
