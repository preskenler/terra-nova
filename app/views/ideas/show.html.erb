<% content_for :title, @idea.title %>

<%= render Ui::BreadcrumbsComponent.new(items: [
      { label: t("nav.home"), path: root_path },
      { label: t("ideas.title"), path: ideas_path },
      { label: @idea.reference }
    ]) %>

<div class="mt-4 grid gap-6 lg:grid-cols-3">
  <div class="space-y-4 lg:col-span-2">
    <div class="flex flex-wrap items-center justify-between gap-2">
      <div>
        <p class="font-mono text-sm text-base-content/60"><%= @idea.reference %></p>
        <h1 class="text-2xl font-bold"><%= @idea.title %></h1>
      </div>
      <%= render Ui::BadgeComponent.new(label: t("ideas.status.#{@idea.status}"), variant: idea_status_variant(@idea)) %>
    </div>
    <p class="whitespace-pre-line text-base-content/90"><%= @idea.description %></p>
    <% if @idea.category.present? %>
      <p class="text-sm text-base-content/60"><%= t("ideas.category") %>: <%= t("projects.categories.#{@idea.category}") %></p>
    <% end %>
  </div>

  <aside class="card border border-base-300 bg-base-100">
    <div class="card-body">
      <h2 class="card-title text-base"><%= t("ideas.supports_title") %></h2>
      <p class="text-sm text-base-content/80"><%= t("ideas.supports_count", count: @idea.support_count) %></p>
      <% if @supporting %>
        <%= button_to t("ideas.supports.remove"), idea_support_path(@idea), method: :delete, class: "btn btn-ghost btn-sm mt-2" %>
      <% else %>
        <%= button_to t("ideas.supports.add"), idea_support_path(@idea), method: :post, class: "btn btn-primary btn-sm mt-2" %>
      <% end %>
    </div>
  </aside>
</div>
