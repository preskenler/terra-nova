<% content_for :title, t("app.name") %>

<section class="grid overflow-hidden rounded-box border border-base-300 bg-base-100 <%= "md:grid-cols-[3fr_2fr]" unless simple_mode? %>">
  <div class="flex min-h-[25rem] flex-col justify-center border-t-4 border-base-content p-8 md:border-l-4 md:border-t-0 md:p-14">
    <span class="text-xs font-extrabold uppercase tracking-widest text-base-content"><%= t("app.name") %></span>
    <h1 class="mt-4 max-w-xl text-balance text-3xl font-extrabold leading-tight sm:text-4xl"><%= t("home.hero.title") %></h1>
    <p class="mt-4 max-w-xl text-base leading-relaxed text-base-content/75"><%= t("home.hero.subtitle") %></p>

    <div class="mt-7 flex flex-wrap gap-3">
      <% if user_signed_in? %>
        <%= link_to t("nav.my_space"), citizen_dashboard_path, class: "btn btn-primary" %>
      <% else %>
        <%= link_to t("nav.sign_up"), new_user_registration_path, class: "btn btn-primary" %>
        <%= link_to t("nav.sign_in"), new_user_session_path, class: "btn btn-ghost" %>
      <% end %>
    </div>
  </div>

  <% unless simple_mode? %>
    <nav class="flex flex-col bg-base-content text-base-100" aria-label="<%= t("home.highlights.title") %>">
      <% home_actions = {
           discover: services_path,
           requests: user_signed_in? ? requests_path : new_user_registration_path,
           alerts: alerts_path
         } %>
      <% home_actions.each_with_index do |(key, path), index| %>
        <%= link_to path, class: "grid flex-1 grid-cols-[auto_1fr_auto] items-start gap-4 border-b border-base-100/20 p-6 no-underline transition-colors last:border-b-0 hover:bg-base-100/10" do %>
          <span class="text-xs font-extrabold tracking-widest text-base-100/60" aria-hidden="true"><%= format("%02d", index + 1) %></span>
          <span>
            <strong class="block text-base"><%= t("home.highlights.#{key}.title") %></strong>
            <span class="mt-1 block text-sm opacity-70"><%= t("home.highlights.#{key}.body") %></span>
          </span>
          <span class="text-lg leading-none" aria-hidden="true">&#8594;</span>
        <% end %>
      <% end %>
    </nav>
  <% end %>
</section>

<% if @alerts.any? || @emergency_services.any? %>
  <div class="mt-6 space-y-3">
  <% if @alerts.any? %>
    <section aria-label="<%= t("alerts.title") %>" class="space-y-3">
    <% @alerts.each do |alert| %>
      <div role="<%= alert.critical? ? "alert" : "status" %>"
           class="alert <%= severity_alert_class(alert.severity) %>">
        <div>
          <p class="font-semibold"><%= alert.title %></p>
          <p class="text-sm"><%= alert.body %></p>
          <% if alert.locality.present? %>
            <p class="mt-1 text-xs"><%= t("alerts.locality", name: alert.locality) %></p>
          <% end %>
        </div>
      </div>
    <% end %>
    </section>
  <% end %>

  <% if @emergency_services.any? %>
    <section aria-labelledby="home-emergency-heading" class="rounded-box border border-error bg-base-100 p-4">
      <div class="flex flex-wrap items-center gap-x-6 gap-y-2">
      <h2 id="home-emergency-heading" class="text-base font-bold"><%= t("services.emergency.title") %></h2>
      <ul class="flex flex-wrap gap-x-6 gap-y-2">
      <% @emergency_services.each do |service| %>
        <li>
          <span class="font-semibold"><%= service.name %></span>
          <% if service.contact_phone.present? %>
            — <a class="link font-mono" href="tel:<%= service.contact_phone.gsub(/[^0-9+]/, "") %>"><%= service.contact_phone %></a>
          <% end %>
        </li>
      <% end %>
      </ul>
      </div>
    </section>
  <% end %>
  </div>
<% end %>

<% priority_services = @priority_services %>
<div class="mt-10 grid gap-10 lg:grid-cols-3">
<% if priority_services.any? %>
  <section class="border-t border-base-300 pt-6 lg:col-span-2" aria-labelledby="home-services-heading">
    <div class="mb-4 flex items-baseline justify-between gap-4">
      <h2 id="home-services-heading" class="text-xl font-bold tracking-tight"><%= t("home.services.title") %></h2>
      <%= link_to t("home.services.see_all"), services_path, class: "link text-sm" %>
    </div>
    <div class="grid gap-4 md:grid-cols-2">
      <% priority_services.each do |service| %>
        <%= render "services/card", service: service %>
      <% end %>
    </div>
  </section>
<% end %>

<% if @announcements.any? && !simple_mode? %>
  <section class="border-t border-base-300 pt-6" aria-labelledby="home-announcements-heading">
    <div class="mb-4 flex items-baseline justify-between gap-4">
      <h2 id="home-announcements-heading" class="text-xl font-bold tracking-tight"><%= t("announcements.title") %></h2>
      <%= link_to t("home.announcements.see_all"), announcements_path, class: "link text-sm" %>
    </div>
    <div>
      <% @announcements.each do |announcement| %>
        <article class="border-b border-base-300 py-5 first:pt-0 last:border-b-0">
          <h3 class="text-base font-bold leading-tight">
            <%= link_to announcement.title, announcement_path(announcement), class: "link link-hover" %>
          </h3>
          <p class="mt-2 text-sm text-base-content/70"><%= truncate(announcement.body.to_s, length: 105) %></p>
        </article>
      <% end %>
    </div>
  </section>
<% end %>
</div>
