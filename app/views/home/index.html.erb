<% content_for :title, t("app.name") %>

<section class="hero-shell <%= "hero-shell-simple" if simple_mode? %>">
  <div class="hero-content">
    <span class="hero-eyebrow"><%= t("app.name") %></span>
    <h1 class="mt-4 max-w-xl text-4xl font-extrabold leading-tight sm:text-5xl"><%= t("home.hero.title") %></h1>
    <p class="mt-4 max-w-xl text-lg leading-relaxed text-base-content/75"><%= t("home.hero.subtitle") %></p>

    <div class="mt-7 flex flex-wrap gap-3">
      <% if user_signed_in? %>
        <%= link_to t("nav.my_space"), citizen_dashboard_path, class: "btn btn-primary" %>
      <% else %>
        <%= link_to t("nav.sign_up"), new_user_registration_path, class: "btn btn-primary" %>
        <%= link_to t("nav.sign_in"), new_user_session_path, class: "btn btn-ghost" %>
      <% end %>
    </div>
  </div>

  <% unless simple_mode? %>
  <nav class="home-actions" aria-label="<%= t("home.highlights.title") %>">
    <% home_actions = {
         discover: services_path,
         requests: user_signed_in? ? requests_path : new_user_registration_path,
         alerts: alerts_path
       } %>
    <% home_actions.each_with_index do |(key, path), index| %>
      <%= link_to path, class: "home-action" do %>
        <span class="home-action-number" aria-hidden="true"><%= format("%02d", index + 1) %></span>
        <span>
          <strong class="block text-base"><%= t("home.highlights.#{key}.title") %></strong>
          <span class="mt-1 block text-sm opacity-70"><%= t("home.highlights.#{key}.body") %></span>
        </span>
        <span class="home-action-arrow" aria-hidden="true">&#8594;</span>
      <% end %>
    <% end %>
  </nav>
  <% end %>
</section>

<% if @alerts.any? || @emergency_services.any? %>
  <div class="mt-6 space-y-3">
  <% if @alerts.any? %>
    <section aria-label="<%= t("alerts.title") %>" class="space-y-3">
    <% @alerts.each do |alert| %>
      <div role="<%= alert.critical? ? "alert" : "status" %>"
           class="alert <%= severity_alert_class(alert.severity) %>">
        <div>
          <p class="font-semibold"><%= alert.title %></p>
          <p class="text-sm"><%= alert.body %></p>
          <% if alert.locality.present? %>
            <p class="mt-1 text-xs"><%= t("alerts.locality", name: alert.locality) %></p>
          <% end %>
        </div>
      </div>
    <% end %>
    </section>
  <% end %>

  <% if @emergency_services.any? %>
    <section aria-labelledby="home-emergency-heading" class="rounded-box border border-error bg-base-100 p-4">
      <div class="flex flex-wrap items-center gap-x-6 gap-y-2">
      <h2 id="home-emergency-heading" class="text-base font-bold"><%= t("services.emergency.title") %></h2>
      <ul class="flex flex-wrap gap-x-6 gap-y-2">
      <% @emergency_services.each do |service| %>
        <li>
          <span class="font-semibold"><%= service.name %></span>
          <% if service.contact_phone.present? %>
            — <a class="link font-mono" href="tel:<%= service.contact_phone.gsub(/[^0-9+]/, "") %>"><%= service.contact_phone %></a>
          <% end %>
        </li>
      <% end %>
      </ul>
      </div>
    </section>
  <% end %>
  </div>
<% end %>

<% priority_services = @priority_services %>
<div class="mt-10 grid gap-10 lg:grid-cols-3">
<% if priority_services.any? %>
  <section class="home-section lg:col-span-2" aria-labelledby="home-services-heading">
    <div class="home-section-header">
      <h2 id="home-services-heading" class="text-xl font-bold"><%= t("home.services.title") %></h2>
      <%= link_to t("home.services.see_all"), services_path, class: "link text-sm" %>
    </div>
    <div class="grid gap-4 md:grid-cols-2">
      <% priority_services.each do |service| %>
        <%= render "services/card", service: service %>
      <% end %>
    </div>
  </section>
<% end %>

<% if @announcements.any? && !simple_mode? %>
  <section class="home-section" aria-labelledby="home-announcements-heading">
    <div class="home-section-header">
      <h2 id="home-announcements-heading" class="text-xl font-bold"><%= t("announcements.title") %></h2>
      <%= link_to t("home.announcements.see_all"), announcements_path, class: "link text-sm" %>
    </div>
    <div>
      <% @announcements.each do |announcement| %>
        <article class="home-news-item">
          <h3 class="text-base font-bold leading-tight">
            <%= link_to announcement.title, announcement_path(announcement), class: "link link-hover" %>
          </h3>
          <p class="mt-2 text-sm text-base-content/70"><%= truncate(announcement.body.to_s, length: 105) %></p>
        </article>
      <% end %>
    </div>
  </section>
<% end %>
</div>
