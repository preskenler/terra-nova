<% content_for :title, t("glossary.title") %>

<%= render Ui::BreadcrumbsComponent.new(items: [
      { label: t("nav.home"), path: root_path },
      { label: t("glossary.title") }
    ]) %>

<h1 class="mt-4 text-2xl font-bold"><%= t("glossary.title") %></h1>
<p class="mt-1 max-w-2xl text-base-content/70"><%= t("glossary.intro") %></p>

<dl class="mt-6 grid gap-4 md:grid-cols-2">
  <% @terms.each do |term| %>
    <div class="rounded-box border border-base-300 bg-base-100 p-4">
      <dt class="text-lg font-semibold"><%= term.term %></dt>
      <dd class="mt-1 text-base-content/80"><%= term.definition %></dd>
    </div>
  <% end %>
</dl>
