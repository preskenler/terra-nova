<% content_for :title, t("requests.title") %>

<%= render Ui::BreadcrumbsComponent.new(items: [
      { label: t("nav.home"), path: root_path },
      { label: t("nav.my_space"), path: citizen_dashboard_path },
      { label: t("requests.title") }
    ]) %>

<div class="mt-4 flex flex-wrap items-start justify-between gap-3">
  <div>
    <h1 class="text-2xl font-bold"><%= t("requests.title") %></h1>
    <p class="mt-1 text-base-content/70"><%= t("requests.subtitle") %></p>
  </div>
  <div class="flex flex-wrap gap-2">
    <%= link_to t("requests.export_csv"), requests_path(format: :csv), class: "btn btn-ghost" %>
    <%= link_to t("requests.new"), new_request_path, class: "btn btn-primary" %>
  </div>
</div>

<%= form_with url: requests_path, method: :get, class: "mt-4 flex flex-wrap items-end gap-3" do %>
  <div>
    <label for="request-q" class="mb-1 block text-sm font-medium"><%= t("requests.filters.search") %></label>
    <%= text_field_tag :q, params[:q], id: "request-q", class: "input input-bordered input-sm" %>
  </div>
  <div>
    <label for="request-status" class="mb-1 block text-sm font-medium"><%= t("requests.filters.status") %></label>
    <%= select_tag :status,
          options_for_select([ [ t("requests.filters.all"), "" ] ] + Request::STATUSES.keys.map { |s| [ t("requests.status.#{s}"), s ] }, params[:status]),
          id: "request-status", class: "select select-bordered select-sm" %>
  </div>
  <div>
    <label for="request-sort" class="mb-1 block text-sm font-medium"><%= t("requests.filters.sort") %></label>
    <%= select_tag :sort,
          options_for_select([ [ t("requests.filters.sort_recent"), "" ], [ t("requests.filters.sort_oldest"), "oldest" ] ], params[:sort]),
          id: "request-sort", class: "select select-bordered select-sm" %>
  </div>
  <%= submit_tag t("actions.filter"), class: "btn btn-primary btn-sm" %>
  <%= link_to t("actions.reset"), requests_path, class: "btn btn-ghost btn-sm" %>
<% end %>

<% if @requests.any? %>
  <ul class="mt-6 space-y-3">
    <% @requests.each do |request| %>
      <li class="rounded-box border border-base-300 bg-base-100 p-4">
        <div class="flex flex-wrap items-start justify-between gap-2">
          <div class="min-w-0">
            <p class="font-mono text-sm text-base-content/60"><%= request.reference %></p>
            <h2 class="text-lg font-semibold">
              <%= link_to request.subject, request_path(request), class: "link link-hover" %>
            </h2>
            <p class="mt-1 text-sm text-base-content/70">
              <%= t("requests.submitted_on", date: l(request.created_at, format: :short)) %>
              <% if request.service %><span aria-hidden="true"> · </span><%= request.service.name %><% end %>
            </p>
          </div>
          <%= render Ui::BadgeComponent.new(
                label: t("requests.status.#{request.status}"),
                variant: request_badge_variant(request.status)) %>
        </div>
      </li>
    <% end %>
  </ul>
<% else %>
  <div class="mt-6">
    <%= render Ui::EmptyStateComponent.new(
          title: t("requests.empty"),
          description: t("requests.empty_hint")) do %>
      <%= link_to t("requests.new"), new_request_path, class: "btn btn-primary btn-sm" %>
    <% end %>
  </div>
<% end %>

<%= render "shared/pagination" %>
