<%= form_with model: request, url: requests_path, class: "mt-6 max-w-2xl space-y-5" do |f| %>
  <% if request.errors.any? %>
    <div role="alert" class="alert alert-error">
      <div>
        <p class="font-semibold"><%= t("forms.errors_summary") %></p>
        <ul class="mt-1 list-disc pl-5">
          <% request.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    </div>
  <% end %>

  <div>
    <%= f.label :service_id, t("requests.form.service"), class: "mb-1 block text-sm font-medium" %>
    <%= f.collection_select :service_id, services, :id, :name,
          { include_blank: t("requests.form.service_none") },
          class: "select select-bordered w-full" %>
  </div>

  <div>
    <%= f.label :subject, t("requests.form.subject"), class: "mb-1 block text-sm font-medium" %>
    <%= f.text_field :subject, class: "input input-bordered w-full", maxlength: 150, required: true %>
  </div>

  <div>
    <%= f.label :description, t("requests.form.description"), class: "mb-1 block text-sm font-medium" %>
    <%= f.text_area :description, rows: 6, class: "textarea textarea-bordered w-full", required: true %>
    <p class="mt-1 text-xs text-base-content/60"><%= t("requests.form.description_hint") %></p>
  </div>

  <div>
    <%= f.label :location_text, t("requests.form.location"), class: "mb-1 block text-sm font-medium" %>
    <%= f.text_field :location_text, class: "input input-bordered w-full",
          placeholder: t("requests.form.location_placeholder"), autocomplete: "street-address" %>
  </div>

  <fieldset class="rounded-box border border-base-300 bg-base-100 p-4">
    <legend class="px-1 text-sm font-medium"><%= t("requests.form.map_legend") %></legend>
    <p class="mb-2 text-xs text-base-content/60"><%= t("requests.form.map_hint") %></p>

    <% unless reduced_data? %>
      <div data-controller="map"
           data-map-interactive-value="true"
           data-map-lat-value="<%= request.latitude %>"
           data-map-lng-value="<%= request.longitude %>"
           data-map-zoom-value="13"
           data-map-label-value="<%= t("requests.form.location") %>">
        <div data-map-target="container"
             role="application"
             aria-label="<%= t("requests.form.map_label") %>"
             class="h-64 w-full overflow-hidden rounded-box border border-base-300"></div>

        <p class="mt-2 text-sm text-base-content/70">
          <%= t("requests.form.coordinates") %>:
          <span data-map-target="coords" class="font-mono">
            <% if request.latitude.present? && request.longitude.present? %>
              <%= request.latitude.to_f.round(5) %>, <%= request.longitude.to_f.round(5) %>
            <% else %>
              <%= t("requests.form.no_coordinates") %>
            <% end %>
          </span>
        </p>
      </div>
    <% else %>
      <p class="text-sm text-base-content/60"><%= t("a11y.reduced_data_note") %></p>
    <% end %>

    <%= f.hidden_field :latitude, data: { map_target: "latInput" } %>
    <%= f.hidden_field :longitude, data: { map_target: "lngInput" } %>
  </fieldset>

  <div class="flex gap-2">
    <%= f.submit t("requests.form.submit"), class: "btn btn-primary" %>
    <%= link_to t("actions.back"), requests_path, class: "btn btn-ghost" %>
  </div>
<% end %>
