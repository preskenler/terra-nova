<% content_for :title, "#{@request.reference} — #{@request.subject}" %>

<%= render Ui::BreadcrumbsComponent.new(items: [
      { label: t("nav.home"), path: root_path },
      { label: t("nav.my_space"), path: citizen_dashboard_path },
      { label: t("requests.title"), path: requests_path },
      { label: @request.reference }
    ]) %>

<div class="mt-4 grid gap-6 lg:grid-cols-3">
  <div class="space-y-4 lg:col-span-2">
    <div class="flex flex-wrap items-center justify-between gap-2">
      <div>
        <p class="font-mono text-sm text-base-content/60"><%= @request.reference %></p>
        <h1 class="text-2xl font-bold"><%= @request.subject %></h1>
      </div>
      <%= render Ui::BadgeComponent.new(
            label: t("requests.status.#{@request.status}"),
            variant: request_badge_variant(@request.status)) %>
    </div>

    <dl class="grid grid-cols-2 gap-3 text-sm sm:grid-cols-3">
      <div>
        <dt class="text-base-content/60"><%= t("requests.fields.submitted_at") %></dt>
        <dd class="font-medium"><%= l(@request.created_at, format: :short) %></dd>
      </div>
      <div>
        <dt class="text-base-content/60"><%= t("requests.fields.service") %></dt>
        <dd class="font-medium"><%= @request.service&.name || "—" %></dd>
      </div>
      <div>
        <dt class="text-base-content/60"><%= t("requests.fields.location") %></dt>
        <dd class="font-medium"><%= @request.location_text.presence || "—" %></dd>
      </div>
    </dl>

    <section>
      <h2 class="text-lg font-semibold"><%= t("requests.fields.description") %></h2>
      <p class="mt-1 whitespace-pre-line text-base-content/90"><%= @request.description %></p>
    </section>

    <% if @request.latitude.present? && @request.longitude.present? %>
      <section aria-labelledby="request-location-heading">
        <h2 id="request-location-heading" class="text-lg font-semibold"><%= t("services.location.title") %></h2>
        <% unless reduced_data? %>
          <div class="mt-2"
               data-controller="map"
               data-map-lat-value="<%= @request.latitude %>"
               data-map-lng-value="<%= @request.longitude %>"
               data-map-label-value="<%= @request.location_text.presence || @request.subject %>">
            <div data-map-target="container"
                 role="img"
                 aria-label="<%= t("requests.map_label", reference: @request.reference) %>"
                 class="h-56 w-full overflow-hidden rounded-box border border-base-300"></div>
          </div>
        <% else %>
          <p class="mt-2 text-sm text-base-content/60"><%= t("a11y.reduced_data_note") %></p>
        <% end %>
      </section>
    <% end %>
  </div>

  <aside class="space-y-4">
    <section class="card border border-base-300 bg-base-100">
      <div class="card-body">
        <h2 class="card-title text-base"><%= t("requests.supports.title") %></h2>
        <p class="text-sm text-base-content/80"><%= t("requests.supports.count", count: @request.support_count) %></p>
        <% if @supporting %>
          <%= button_to t("requests.supports.remove"), request_support_path(@request), method: :delete,
                class: "btn btn-ghost btn-sm mt-2" %>
        <% else %>
          <%= button_to t("requests.supports.add"), request_support_path(@request), method: :post,
                class: "btn btn-primary btn-sm mt-2" %>
        <% end %>
      </div>
    </section>

    <section class="card border border-base-300 bg-base-100">
      <div class="card-body">
        <h2 class="card-title text-base"><%= t("requests.timeline.title") %></h2>
        <%= render "requests/timeline", events: @events %>
      </div>
    </section>
  </aside>
</div>
