<% if any? %>
  <div class="mx-auto w-full max-w-6xl px-4 pt-4" aria-live="polite">
    <% if @notice.present? %>
      <div role="status" class="alert alert-success">
        <span><%= @notice %></span>
      </div>
    <% end %>
    <% if @alert.present? %>
      <div role="alert" class="alert alert-error">
        <span><%= @alert %></span>
      </div>
    <% end %>
  </div>
<% end %>
