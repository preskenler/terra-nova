<details class="dropdown dropdown-end">
  <summary class="btn btn-ghost btn-sm" aria-haspopup="true">
    <span aria-hidden="true">&#9881;</span>
    <span><%= t("a11y.controls") %></span>
  </summary>
  <div class="dropdown-content z-40 mt-2 w-72 rounded-box border border-base-300 bg-base-100 p-4 shadow-lg">
    <%= form_with url: preferences_path, method: :patch, class: "space-y-3" do %>
      <p class="text-sm font-semibold"><%= t("a11y.display_settings") %></p>

      <label class="flex cursor-pointer items-center gap-2">
        <%= check_box_tag :high_contrast, "1", @high_contrast, class: "checkbox checkbox-sm" %>
        <span><%= t("a11y.high_contrast") %></span>
      </label>

      <label class="flex cursor-pointer items-center gap-2">
        <%= check_box_tag :large_text, "1", @large_text, class: "checkbox checkbox-sm" %>
        <span><%= t("a11y.large_text") %></span>
      </label>

      <%= submit_tag t("a11y.apply"), class: "btn btn-primary btn-sm w-full" %>
    <% end %>
  </div>
</details>
