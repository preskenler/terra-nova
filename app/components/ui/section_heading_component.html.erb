<div class="mb-3 mt-6 flex items-center gap-3">
  <span class="h-6 w-1.5 flex-none rounded-full bg-primary" aria-hidden="true"></span>
  <% if @id.present? %>
    <h2 id="<%= @id %>" class="text-lg font-bold tracking-tight"><%= @title %></h2>
  <% else %>
    <h2 class="text-lg font-bold tracking-tight"><%= @title %></h2>
  <% end %>
</div>
