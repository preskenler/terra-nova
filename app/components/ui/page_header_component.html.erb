<header class="mb-7 mt-4 flex flex-wrap items-end justify-between gap-4">
  <div>
    <h1 class="text-2xl font-extrabold tracking-tight text-balance"><%= @title %></h1>
    <% if @subtitle.present? %>
      <p class="mt-1 max-w-3xl text-base-content/70"><%= @subtitle %></p>
    <% end %>
  </div>

  <% if content? %>
    <div class="flex flex-wrap items-center gap-2"><%= content %></div>
  <% end %>
</header>
