# Copy this file to `.env` and adjust the values as needed. Every variable is
# optional; the defaults shown here match docker-compose.yml.
#
#   cp .env.example .env

# Database (MySQL 8.4). On cPanel/Hostinger, use the database, user and host
# provided by the hosting panel (usually host `localhost`).
DB_USERNAME=rails
DB_PASSWORD=password
DB_DATABASE=terra_nova_development
DB_TEST_DATABASE=terra_nova_test
DB_HOST=127.0.0.1
DB_PORT=3306

# Host port mapped to MySQL inside the container. Change it if you already run
# a MySQL server on 3306 (e.g. 3307).
DB_HOST_PORT=3306

# External "Terra Nova" (Webcup) API. Server-side only: the key is never exposed
# to the browser. Prefer Rails credentials in production
# (bin/rails credentials:edit -> webcup.api_key).
# WEBCUP_API_BASE_URL=https://24h.webcup.fr/wp-json/webcup/v1
# WEBCUP_API_KEY=your-api-key
# WEBCUP_POLL_INTERVAL=30

# Production (cPanel/Hostinger).
# APP_HOST=preskenlair.lareunion.webcup.hodi.cloud
# RAILS_MASTER_KEY=...
# SOLID_QUEUE_IN_PUMA=true
# SMTP_ADDRESS=smtp.example.com
# SMTP_PORT=587
# SMTP_USER_NAME=...
# SMTP_PASSWORD=...
# SMTP_AUTHENTICATION=plain
# MAILER_FROM=no-reply@example.com
